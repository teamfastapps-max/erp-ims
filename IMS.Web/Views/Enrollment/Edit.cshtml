@model IMS.Models.ViewModels.EnrollmentFormViewModel
@{ ViewData["Title"] = "Edit Enrollment"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-user-plus me-2"></i>Edit Enrollment</h3>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form id="enrollmentEditForm" asp-controller="Enrollment" asp-action="EditEnrollment" method="post">
            @Html.AntiForgeryToken()
            <partial name="_Form" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/common/datepicker.js"></script>
<script>
$(function () {
    IMSDatePicker.init({ input: '#E_EnrollmentDate', format: 'dd/MM/yyyy', valueFormat: 'yyyy-MM-dd', placeholder: 'DD/MM/YYYY' });
    IMSDatePicker.init({ input: '#E_CompletionDate', format: 'dd/MM/yyyy', valueFormat: 'yyyy-MM-dd', placeholder: 'DD/MM/YYYY' });

    $('.select2-student').select2({
        theme: 'bootstrap-5',
        width: '100%',
        placeholder: 'Type to search student...',
        allowClear: true,
        minimumInputLength: 0
    });

    $("form").on("submit", function (e) {
        e.preventDefault();
        var $form = $(this), $btn = $form.find("button[type='submit']");
        $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-1"></span> Saving...');
        $.ajax({ url: $form.attr("action"), type: "POST", data: $form.serialize(),
            success: function (r) { if (r.success) { if (window.toastr) toastr.success(r.message); setTimeout(function(){window.location.href="/Enrollment/Index";},700); } else { if (window.toastr) toastr.error(r.message); $btn.prop("disabled", false).html('<i class="fa-solid fa-check me-1"></i> Save Enrollment'); } },
            error: function () { if (window.toastr) toastr.error("Request failed."); $btn.prop("disabled", false).html('<i class="fa-solid fa-check me-1"></i> Save Enrollment'); }
        });
    });
});
</script>
}
