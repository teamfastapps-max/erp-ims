@model IMS.Models.ViewModels.EnrollmentFormViewModel

@if (Model.E_Id.HasValue) { @Html.HiddenFor(m => m.E_Id) }

<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label">Student <span class="text-danger">*</span></label>
        @Html.DropDownListFor(m => m.E_StudentId, Model.StudentOptions, "Select Student", new { @class = "form-select select2-student", @id = "E_StudentId" })
        <div class="text-danger small field-error" data-for="E_StudentId"></div>
    </div>
    <div class="col-md-6">
        <label class="form-label">Enrollment Number</label>
        @Html.TextBoxFor(m => m.E_EnrollmentNumber, new { @class = "form-control", placeholder = "Auto-generated if blank" })
    </div>
    <div class="col-md-4">
        <label class="form-label">Academic Year <span class="text-danger">*</span></label>
        @Html.DropDownListFor(m => m.E_AcademicYearId, Model.AcademicYearOptions, "Select Year", new { @class = "form-select" })
    </div>
    <div class="col-md-4">
        <label class="form-label">Course <span class="text-danger">*</span></label>
        @Html.DropDownListFor(m => m.E_CourseId, Model.CourseOptions, "Select Course", new { @class = "form-select" })
    </div>
    <div class="col-md-4">
        <label class="form-label">Batch <span class="text-danger">*</span></label>
        @Html.DropDownListFor(m => m.E_BatchId, Model.BatchOptions, "Select Batch", new { @class = "form-select" })
    </div>
    <div class="col-md-4">
        <label class="form-label">Enrollment Date <span class="text-danger">*</span></label>
        @Html.TextBoxFor(m => m.E_EnrollmentDate, "{0:yyyy-MM-dd}", new { @class = "form-control ims-datepicker-input", placeholder = "DD/MM/YYYY", @id = "E_EnrollmentDate" })
    </div>
    <div class="col-md-4">
        <label class="form-label">Status <span class="text-danger">*</span></label>
        @Html.DropDownListFor(m => m.E_Status, Model.StatusOptions, new { @class = "form-select" })
    </div>
    <div class="col-md-4">
        <label class="form-label">Completion Date</label>
        @Html.TextBoxFor(m => m.E_CompletionDate, "{0:yyyy-MM-dd}", new { @class = "form-control ims-datepicker-input", placeholder = "DD/MM/YYYY", @id = "E_CompletionDate" })
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mt-4">
    <a asp-controller="Enrollment" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i> Save Enrollment</button>
</div>
