@model IMS.Models.ViewModels.EnrollmentIndexViewModel
@{ ViewData["Title"] = "Enrollments"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-user-plus me-2"></i>Enrollments</h3>
    <a asp-controller="Enrollment" asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-plus me-1"></i> New Enrollment
    </a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Index", "Enrollment", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-3">
                @Html.Label("searchTerm", "Search", new { @class = "form-label" })
                @Html.TextBox("searchTerm", Model.SearchTerm, new { @class = "form-control", placeholder = "Enrollment # or student name" })
            </div>
            <div class="col-md-2">
                @Html.Label("status", "Status", new { @class = "form-label" })
                @Html.DropDownList("status", Model.StatusOptions, "All Statuses", new { @class = "form-select" })
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-primary"><i class="fa-solid fa-search me-1"></i> Filter</button>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive p-3">
        <table id="dataTable" class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Enrollment #</th>
                    <th>Student</th>
                    <th>Course</th>
                    <th>Batch</th>
                    <th>Academic Year</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Enrollments.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No enrollments found.</td></tr>
                }
                else
                {
                    foreach (var e in Model.Enrollments)
                    {
                        <tr id="enrollment-row-@e.E_Id">
                            <td>@e.E_EnrollmentNumber</td>
                            <td>@e.StudentName</td>
                            <td>@e.CourseName</td>
                            <td>@e.BatchName</td>
                            <td>@e.AcademicYearName</td>
                            <td>@e.E_EnrollmentDate.ToString("dd-MMM-yyyy")</td>
                            <td><span class="badge @StatusBadge(e.E_Status)">@e.E_Status</span></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@e.E_Id" class="btn btn-sm btn-outline-secondary" title="View"><i class="fa-solid fa-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@e.E_Id" class="btn btn-sm btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                <button class="btn btn-sm btn-outline-danger enroll-delete-btn" data-id="@e.E_Id" title="Delete"><i class="fa-solid fa-trash"></i></button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

@functions { string StatusBadge(string s) => s switch { "Active" => "bg-success", "Completed" => "bg-info text-dark", "Withdrawn" => "bg-warning text-dark", "Transferred" => "bg-primary", _ => "bg-light text-dark" }; }

@section Scripts {
<script>
$(function () {
    $('#dataTable').DataTable({ pageLength: 10, lengthMenu: [10, 25, 50, 100], order: [[0, 'desc']] });
    $(document).on("click", ".enroll-delete-btn", function () {
        var id = $(this).data("id");
        if (!confirm("Delete this enrollment?")) return;
        $.ajax({ url: "/Enrollment/DeleteEnrollment/" + id, type: "POST",
            data: { __RequestVerificationToken: $("input[name='__RequestVerificationToken']").val() },
            success: function (r) { if (r.success) { if (window.toastr) toastr.success(r.message); $("#enrollment-row-" + id).fadeOut(300, function(){$(this).remove();}); } else { if (window.toastr) toastr.error(r.message); } },
            error: function () { if (window.toastr) toastr.error("Request failed."); }
        });
    });
});
</script>
}
