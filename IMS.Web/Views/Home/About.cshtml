@{
    ViewData["Title"] = "About Us";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}

<link rel="stylesheet" href="~/css/about.css" asp-append-version="true" /> 

<div class="about-page">

    <!-- =========================================
         HERO
    ========================================== -->
    <section class="about-hero">
        <div class="container">
            <div class="about-hero-content about-reveal">

                <div class="about-eyebrow">
                    About Our Platform
                </div>

                <h1>
                    Technology that helps
                    <em>schools thrive.</em>
                </h1>

                <p class="about-hero-text">
                    Our School Management System brings the everyday operations
                    of a modern school together in one simple, secure and
                    connected platform.
                </p>

                <div class="about-hero-meta">

                    <div class="about-meta-item">
                        <i class="bi bi-shield-check"></i>
                        Secure &amp; Reliable
                    </div>

                    <div class="about-meta-item">
                        <i class="bi bi-grid-1x2"></i>
                        Unified Management
                    </div>

                    <div class="about-meta-item">
                        <i class="bi bi-phone"></i>
                        Accessible Anywhere
                    </div>

                </div>

            </div>
        </div>
    </section>


    <!-- =========================================
         INTRODUCTION
    ========================================== -->
    <section class="about-intro">
        <div class="container">

            <div class="row align-items-center g-5">

                <div class="col-lg-7 about-reveal">

                    <div class="about-section-tag">
                        Who We Are
                    </div>

                    <h2 class="about-heading">
                        One connected system for
                        <em>the whole school.</em>
                    </h2>

                    <p class="about-copy">
                        A school is a complex ecosystem. Students, teachers,
                        guardians, administrators and staff all depend on
                        accurate information and smooth communication every day.
                    </p>

                    <p class="about-copy">
                        Our platform is designed to bring these different
                        responsibilities together, helping schools manage
                        information, academic activities and administrative
                        processes from a centralized environment.
                    </p>

                    <p class="about-copy">
                        Instead of relying on disconnected systems and manual
                        processes, schools can use one platform to keep their
                        operations organized, accessible and easier to manage.
                    </p>

                </div>

                <div class="col-lg-5 about-reveal">

                    <div class="about-highlight">

                        <div class="about-highlight-content">

                            <h3>
                                “Technology should simplify
                                school administration,
                                not make it more complicated.”
                            </h3>

                            <p>
                                That principle guides the way our School
                                Management System is designed — practical,
                                focused and built around real school operations.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </section>


    <!-- =========================================
         NUMBERS
    ========================================== -->
    <section class="about-numbers">

        <div class="container">

            <div class="row">

                <div class="col-6 col-lg-3 number-item">
                    <div class="number-value">
                        <span class="about-counter" data-target="1250">0</span>+
                    </div>
                    <div class="number-label">
                        Students Managed
                    </div>
                </div>

                <div class="col-6 col-lg-3 number-item">
                    <div class="number-value">
                        <span class="about-counter" data-target="85">0</span>+
                    </div>
                    <div class="number-label">
                        Teachers &amp; Staff
                    </div>
                </div>

                <div class="col-6 col-lg-3 number-item">
                    <div class="number-value">
                        <span class="about-counter" data-target="25">0</span>+
                    </div>
                    <div class="number-label">
                        Management Modules
                    </div>
                </div>

                <div class="col-6 col-lg-3 number-item">
                    <div class="number-value">
                        <span class="about-counter" data-target="99">0</span>%
                    </div>
                    <div class="number-label">
                        System Reliability
                    </div>
                </div>

            </div>

        </div>

    </section>


    <!-- =========================================
         MISSION & VISION
    ========================================== -->
    <section class="mission-section">

        <div class="container">

            <div class="row g-4">

                <div class="col-lg-6 about-reveal">

                    <div class="mission-card">

                        <div class="mission-icon">
                            <i class="bi bi-bullseye"></i>
                        </div>

                        <h3>Our Mission</h3>

                        <p>
                            Our mission is to simplify school administration
                            through technology that is reliable, accessible
                            and easy to use.
                        </p>

                        <p>
                            We aim to reduce repetitive administrative work,
                            improve information management and give school
                            teams more time to focus on students and education.
                        </p>

                    </div>

                </div>

                <div class="col-lg-6 about-reveal">

                    <div class="mission-card">

                        <div class="mission-icon">
                            <i class="bi bi-eye"></i>
                        </div>

                        <h3>Our Vision</h3>

                        <p>
                            We envision a future where schools can operate
                            through a connected digital environment where
                            information is organized, accessible and secure.
                        </p>

                        <p>
                            Our goal is to continuously improve the way
                            technology supports educational institutions and
                            the people who make them successful.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================
         MODULES
    ========================================== -->
    <section class="modules-section">

        <div class="container">

            <div class="modules-intro about-reveal">

                <div class="about-section-tag">
                    What We Manage
                </div>

                <h2 class="about-heading">
                    Everything important,
                    <em>in one place.</em>
                </h2>

                <p class="about-copy">
                    The platform is designed to support the different areas
                    involved in everyday school administration and academics.
                </p>

            </div>


            <div class="row modules-list">

                <div class="col-lg-6">

                    <div class="module-item about-reveal">
                        <div class="module-number">01</div>

                        <i class="bi bi-people module-icon"></i>

                        <div>
                            <h5>Student Management</h5>
                            <p>Profiles, records and academic information.</p>
                        </div>
                    </div>

                    <div class="module-item about-reveal">
                        <div class="module-number">02</div>

                        <i class="bi bi-person-workspace module-icon"></i>

                        <div>
                            <h5>Teacher &amp; Staff Management</h5>
                            <p>Organize staff information and responsibilities.</p>
                        </div>
                    </div>

                    <div class="module-item about-reveal">
                        <div class="module-number">03</div>

                        <i class="bi bi-person-heart module-icon"></i>

                        <div>
                            <h5>Guardian Management</h5>
                            <p>Maintain connected student and guardian records.</p>
                        </div>
                    </div>

                    <div class="module-item about-reveal">
                        <div class="module-number">04</div>

                        <i class="bi bi-calendar-check module-icon"></i>

                        <div>
                            <h5>Attendance Management</h5>
                            <p>Track and maintain attendance records.</p>
                        </div>
                    </div>

                    <div class="module-item about-reveal">
                        <div class="module-number">05</div>

                        <i class="bi bi-book module-icon"></i>

                        <div>
                            <h5>Academic Management</h5>
                            <p>Classes, subjects, examinations and results.</p>
                        </div>
                    </div>

                </div>


                <div class="col-lg-6">

                    <div class="module-item about-reveal">
                        <div class="module-number">06</div>

                        <i class="bi bi-cash-stack module-icon"></i>

                        <div>
                            <h5>Fee Management</h5>
                            <p>Manage fee information and payment records.</p>
                        </div>
                    </div>

                    <div class="module-item about-reveal">
                        <div class="module-number">07</div>

                        <i class="bi bi-box-seam module-icon"></i>

                        <div>
                            <h5>Inventory &amp; Stock</h5>
                            <p>Track school inventory and stock movement.</p>
                        </div>
                    </div>

                    <div class="module-item about-reveal">
                        <div class="module-number">08</div>

                        <i class="bi bi-shop module-icon"></i>

                        <div>
                            <h5>Vendor Management</h5>
                            <p>Manage vendors and procurement activities.</p>
                        </div>
                    </div>

                    <div class="module-item about-reveal">
                        <div class="module-number">09</div>

                        <i class="bi bi-bar-chart module-icon"></i>

                        <div>
                            <h5>Reports &amp; Analytics</h5>
                            <p>Access useful reports for better decisions.</p>
                        </div>
                    </div>

                    <div class="module-item about-reveal">
                        <div class="module-number">10</div>

                        <i class="bi bi-shield-lock module-icon"></i>

                        <div>
                            <h5>User &amp; Role Management</h5>
                            <p>Secure access based on user responsibilities.</p>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================
         WHY CHOOSE US
    ========================================== -->
    <section class="why-about-section">

        <div class="container">

            <div class="row align-items-center g-5">

                <div class="col-lg-6 about-reveal">

                    <div class="about-section-tag">
                        Why Choose Us
                    </div>

                    <h2 class="about-heading">
                        Built around the way
                        <em>schools actually work.</em>
                    </h2>

                    <p class="about-copy">
                        We focus on creating a practical management experience
                        that makes everyday administrative tasks clearer and
                        easier for school teams.
                    </p>


                    <div class="why-list">

                        <div class="why-item">
                            <div class="why-check">
                                <i class="bi bi-check-lg"></i>
                            </div>

                            <div>
                                <h5>Centralized Information</h5>
                                <p>
                                    Keep essential school information organized
                                    within one connected platform.
                                </p>
                            </div>
                        </div>


                        <div class="why-item">
                            <div class="why-check">
                                <i class="bi bi-check-lg"></i>
                            </div>

                            <div>
                                <h5>Role-Based Access</h5>
                                <p>
                                    Provide users with access appropriate to
                                    their responsibilities.
                                </p>
                            </div>
                        </div>


                        <div class="why-item">
                            <div class="why-check">
                                <i class="bi bi-check-lg"></i>
                            </div>

                            <div>
                                <h5>Simple User Experience</h5>
                                <p>
                                    Designed with clear navigation and
                                    straightforward workflows.
                                </p>
                            </div>
                        </div>


                        <div class="why-item">
                            <div class="why-check">
                                <i class="bi bi-check-lg"></i>
                            </div>

                            <div>
                                <h5>Scalable Architecture</h5>
                                <p>
                                    Built to support the changing needs of
                                    growing educational institutions.
                                </p>
                            </div>
                        </div>

                    </div>

                </div>


                <div class="col-lg-6">

                    <div class="why-visual about-reveal">

                        <div class="school-emblem">
                            <i class="bi bi-mortarboard-fill"></i>
                            <span>Learn. Manage. Grow.</span>
                        </div>

                        <div class="visual-card visual-card-one">
                            <strong>
                                <i class="bi bi-shield-check me-1"></i>
                                Secure Access
                            </strong>
                            <small>Role-based permissions</small>
                        </div>

                        <div class="visual-card visual-card-two">
                            <strong>
                                <i class="bi bi-bar-chart me-1"></i>
                                Better Insights
                            </strong>
                            <small>Reports &amp; analytics</small>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================
         CTA
    ========================================== -->
    <section class="about-cta">

        <div class="container">

            <div class="about-cta-inner about-reveal">

                <div class="about-cta-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>

                <h2>
                    Let's build a
                    <em>smarter school.</em>
                </h2>

                <p>
                    Discover how a connected school management platform can
                    simplify administration and create a better experience
                    for everyone in your institution.
                </p>

                <div>

                    <a asp-controller="Home"
                       asp-action="Contact"
                       class="btn about-btn-primary">
                        Contact Us
                        <i class="bi bi-arrow-right ms-1"></i>
                    </a>

                    <a asp-controller="Home"
                       asp-action="Academics"
                       class="btn about-btn-outline">
                        Explore Academics
                    </a>

                </div>

            </div>

        </div>

    </section>

</div>

 <script src="~/js/about.js" asp-append-version="true"></script> 