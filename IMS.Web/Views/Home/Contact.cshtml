@{
    ViewData["Title"] = "Contact Us";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";

}

<div class="contact-page">

    <!-- Hero -->
    <section class="contact-hero">
        <div class="container">
            <div class="contact-hero-content">
                <span class="contact-eyebrow">GET IN TOUCH</span>

                <h1>
                    We'd love to<br />
                    <span>hear from you.</span>
                </h1>

                <p>
                    Whether you are looking for admission information, have a
                    question about our school, or simply want to learn more,
                    our team is here to help.
                </p>
            </div>
        </div>
    </section>


    <!-- Contact Information + Form -->
    <section class="contact-main">
        <div class="container">
            <div class="row g-5">

                <!-- Contact Information -->
                <div class="col-lg-5">

                    <div class="contact-section-heading">
                        <span class="section-tag">CONTACT US</span>

                        <h2>
                            Let's start a
                            <span>conversation.</span>
                        </h2>

                        <p>
                            Reach out to us for admissions, academics,
                            transportation, school activities, or any
                            other information you need.
                        </p>
                    </div>


                    <div class="contact-details">

                        <!-- Address -->
                        <div class="contact-detail">
                            <div class="contact-detail-icon">
                                <i class="bi bi-geo-alt"></i>
                            </div>

                            <div>
                                <span>VISIT US</span>
                                <h5>School Address</h5>

                                <p>
                                    123 Education Road,<br />
                                    Kolkata, West Bengal – 700001
                                </p>
                            </div>
                        </div>


                        <!-- Phone -->
                        <div class="contact-detail">
                            <div class="contact-detail-icon">
                                <i class="bi bi-telephone"></i>
                            </div>

                            <div>
                                <span>CALL US</span>
                                <h5>+91 98765 43210</h5>

                                <p>
                                    Monday – Saturday<br />
                                    8:00 AM – 4:00 PM
                                </p>
                            </div>
                        </div>


                        <!-- Email -->
                        <div class="contact-detail">
                            <div class="contact-detail-icon">
                                <i class="bi bi-envelope"></i>
                            </div>

                            <div>
                                <span>EMAIL US</span>
                                <h5>info@yourschool.edu</h5>

                                <p>
                                    We usually respond within one
                                    working day.
                                </p>
                            </div>
                        </div>

                    </div>


                    <!-- Social -->
                    <div class="contact-social">
                        <span>FOLLOW OUR SCHOOL</span>

                        <div class="contact-social-links">

                            <a href="#" aria-label="Facebook">
                                <i class="bi bi-facebook"></i>
                            </a>

                            <a href="#" aria-label="Instagram">
                                <i class="bi bi-instagram"></i>
                            </a>

                            <a href="#" aria-label="YouTube">
                                <i class="bi bi-youtube"></i>
                            </a>

                            <a href="#" aria-label="LinkedIn">
                                <i class="bi bi-linkedin"></i>
                            </a>

                        </div>
                    </div>

                </div>


                <!-- Contact Form -->
                <div class="col-lg-7">

                    <div class="contact-form-card">

                        <div class="form-card-header">
                            <span class="section-tag">SEND A MESSAGE</span>

                            <h3>
                                How can we
                                <span>help you?</span>
                            </h3>

                            <p>
                                Fill out the form below and our school
                                administration team will get back to you.
                            </p>
                        </div>


                        <form id="contactForm"
                              asp-controller="Home"
                              asp-action="Contact"
                              method="post">

                            <div class="row g-4">

                                <!-- Name -->
                                <div class="col-md-6">
                                    <div class="contact-form-group">
                                        <label for="name">
                                            Your Name
                                        </label>

                                        <input type="text"
                                               id="name"
                                               name="Name"
                                               class="form-control"
                                               placeholder="Enter your name"
                                               required />

                                        <div class="invalid-feedback">
                                            Please enter your name.
                                        </div>
                                    </div>
                                </div>


                                <!-- Phone -->
                                <div class="col-md-6">
                                    <div class="contact-form-group">
                                        <label for="phone">
                                            Phone Number
                                        </label>

                                        <input type="tel"
                                               id="phone"
                                               name="Phone"
                                               class="form-control"
                                               placeholder="+91 98765 43210"
                                               maxlength="15"
                                               required />

                                        <div class="invalid-feedback">
                                            Please enter a valid phone number.
                                        </div>
                                    </div>
                                </div>


                                <!-- Email -->
                                <div class="col-md-6">
                                    <div class="contact-form-group">
                                        <label for="email">
                                            Email Address
                                        </label>

                                        <input type="email"
                                               id="email"
                                               name="Email"
                                               class="form-control"
                                               placeholder="you@example.com"
                                               required />

                                        <div class="invalid-feedback">
                                            Please enter a valid email address.
                                        </div>
                                    </div>
                                </div>


                                <!-- Enquiry Type -->
                                <div class="col-md-6">
                                    <div class="contact-form-group">
                                        <label for="enquiryType">
                                            Enquiry Type
                                        </label>

                                        <select id="enquiryType"
                                                name="EnquiryType"
                                                class="form-select"
                                                required>

                                            <option value="">
                                                Select an enquiry
                                            </option>

                                            <option value="Admission">
                                                Admission
                                            </option>

                                            <option value="Academics">
                                                Academics
                                            </option>

                                            <option value="Transport">
                                                Transport
                                            </option>

                                            <option value="Fees">
                                                Fees & Payment
                                            </option>

                                            <option value="General">
                                                General Enquiry
                                            </option>

                                            <option value="Other">
                                                Other
                                            </option>

                                        </select>

                                        <div class="invalid-feedback">
                                            Please select an enquiry type.
                                        </div>
                                    </div>
                                </div>


                                <!-- Student Class -->
                                <div class="col-md-6">
                                    <div class="contact-form-group">
                                        <label for="studentClass">
                                            Class / Grade
                                        </label>

                                        <select id="studentClass"
                                                name="StudentClass"
                                                class="form-select">

                                            <option value="">
                                                Select class / grade
                                            </option>

                                            <option>Pre-Nursery</option>
                                            <option>Nursery</option>
                                            <option>LKG</option>
                                            <option>UKG</option>
                                            <option>Class I</option>
                                            <option>Class II</option>
                                            <option>Class III</option>
                                            <option>Class IV</option>
                                            <option>Class V</option>
                                            <option>Class VI</option>
                                            <option>Class VII</option>
                                            <option>Class VIII</option>
                                            <option>Class IX</option>
                                            <option>Class X</option>
                                            <option>Class XI</option>
                                            <option>Class XII</option>

                                        </select>
                                    </div>
                                </div>


                                <!-- Preferred Contact -->
                                <div class="col-md-6">
                                    <div class="contact-form-group">
                                        <label for="preferredContact">
                                            Preferred Contact
                                        </label>

                                        <select id="preferredContact"
                                                name="PreferredContact"
                                                class="form-select">

                                            <option value="">
                                                Select preference
                                            </option>

                                            <option value="Phone">
                                                Phone Call
                                            </option>

                                            <option value="Email">
                                                Email
                                            </option>

                                            <option value="WhatsApp">
                                                WhatsApp
                                            </option>

                                        </select>
                                    </div>
                                </div>


                                <!-- Message -->
                                <div class="col-12">
                                    <div class="contact-form-group">
                                        <label for="message">
                                            Your Message
                                        </label>

                                        <textarea id="message"
                                                  name="Message"
                                                  class="form-control"
                                                  rows="5"
                                                  maxlength="1000"
                                                  placeholder="Tell us how we can help..."
                                                  required></textarea>

                                        <div class="message-counter">
                                            <span id="messageCount">0</span>
                                            / 1000
                                        </div>

                                        <div class="invalid-feedback">
                                            Please enter your message.
                                        </div>
                                    </div>
                                </div>


                                <!-- Submit -->
                                <div class="col-12">

                                    <button type="submit"
                                            class="contact-submit-btn">

                                        <span>Send Message</span>

                                        <i class="bi bi-arrow-up-right"></i>

                                    </button>

                                    <p class="form-note">
                                        <i class="bi bi-shield-check"></i>
                                        Your information will only be used
                                        to respond to your enquiry.
                                    </p>

                                </div>

                            </div>

                        </form>

                    </div>

                </div>

            </div>
        </div>
    </section>


    <!-- Office Hours -->
    <section class="contact-hours">
        <div class="container">

            <div class="hours-card">

                <div class="hours-icon">
                    <i class="bi bi-clock"></i>
                </div>

                <div class="hours-content">
                    <span class="section-tag">OFFICE HOURS</span>

                    <h3>When you can reach us</h3>

                    <p>
                        Our administrative office is available during
                        school working hours.
                    </p>
                </div>

                <div class="hours-list">

                    <div>
                        <span>Monday – Friday</span>
                        <strong>8:00 AM – 4:00 PM</strong>
                    </div>

                    <div>
                        <span>Saturday</span>
                        <strong>8:00 AM – 1:00 PM</strong>
                    </div>

                    <div>
                        <span>Sunday</span>
                        <strong>Closed</strong>
                    </div>

                </div>

            </div>

        </div>
    </section>


    <!-- Map / Location -->
    <section class="contact-location">

        <div class="container">

            <div class="location-heading">

                <div>
                    <span class="section-tag">FIND OUR SCHOOL</span>

                    <h2>
                        Come and
                        <span>visit us.</span>
                    </h2>
                </div>

                <a href="https://www.google.com/maps"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="map-link">

                    Get Directions
                    <i class="bi bi-arrow-up-right"></i>

                </a>

            </div>


            <div class="map-container">

                <iframe src="https://www.google.com/maps?q=Kolkata,West%20Bengal&output=embed"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        title="School Location">
                </iframe>

                <div class="map-overlay-card">

                    <div class="map-card-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>

                    <div>
                        <strong>School Management System</strong>

                        <span>
                            123 Education Road, Kolkata
                        </span>
                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->
    <section class="contact-cta">

        <div class="container">

            <div class="contact-cta-inner">

                <div>
                    <span>HAVE MORE QUESTIONS?</span>

                    <h2>
                        We're here to help your
                        <em>family.</em>
                    </h2>
                </div>

                <a asp-controller="Home"
                   asp-action="Admission"
                   class="contact-cta-btn">

                    Explore Admissions
                    <i class="bi bi-arrow-up-right"></i>

                </a>

            </div>

        </div>

    </section>

</div>