@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-4">

    <h3>Welcome, @User.Identity?.Name</h3>
    <h5>You are a : @ViewBag.RedisRoles</h5>

    <div class="row mt-4">

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5>Total Vendors</h5>
                    <h2>120</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5>Purchase Orders</h5>
                    <h2>35</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5>Stock Items</h5>
                    <h2>1540</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5>Low Stock</h5>
                    <h2>18</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="row mt-4">

        <div class="col-md-8">

            <div class="card">

                <div class="card-header">
                </div>

                <div class="card-body">

                    <table class="table table-striped">

                        <thead>
                            <tr>
                                <th>Activity</th>
                                <th>Date</th>
                            </tr>
                        </thead>

                        <tbody>

                            <tr>
                                <td>Vendor Registered</td>
                                <td>09-Jul-2026</td>
                            </tr>

                            <tr>
                                <td>Purchase Order Approved</td>
                                <td>09-Jul-2026</td>
                            </tr>

                            <tr>
                                <td>Goods Receipt Created</td>
                                <td>09-Jul-2026</td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card">

                <div class="card-header">
                    Quick Actions
                </div>

                <div class="card-body d-grid gap-2">

                    <a href="#" class="btn btn-primary">Add Vendor</a>

                    <a href="#" class="btn btn-success">Create Purchase Order</a>

                    <a href="#" class="btn btn-warning">Goods Receipt</a>

                    <a href="#" class="btn btn-info">Inventory</a>

                    <a href="#" class="btn btn-secondary">Reports</a>

                </div>

            </div>

        </div>

    </div>

</div>