@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid mt-4">

    <!-- Welcome Section -->
    <h3>Welcome, @User.Identity?.Name</h3>
    <h5>You are logged in as: @ViewBag.RedisRoles</h5>

    <!-- Dashboard Statistics -->
    <div class="row mt-4">

        <!-- Total Students -->
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5>Total Students</h5>
                    <h2>120</h2>
                </div>
            </div>
        </div>

        <!-- Total Teachers -->
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5>Total Teachers</h5>
                    <h2>35</h2>
                </div>
            </div>
        </div>

        <!-- Total Courses -->
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5>Total Courses</h5>
                    <h2>24</h2>
                </div>
            </div>
        </div>

        <!-- Active Batches -->
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5>Active Batches</h5>
                    <h2>18</h2>
                </div>
            </div>
        </div>

    </div>


    <div class="row mt-4">

        <!-- Recent Activities -->
        <div class="col-md-8">

            <div class="card">

                <div class="card-header">
                    <strong>Recent Activities</strong>
                </div>

                <div class="card-body">

                    <table class="table table-striped">

                        <thead>
                            <tr>
                                <th>Activity</th>
                                <th>Date</th>
                            </tr>
                        </thead>

                        <tbody>

                            <tr>
                                <td>New Student Registered</td>
                                <td>@DateTime.Now.ToString("dd-MMM-yyyy")</td>
                            </tr>

                            <tr>
                                <td>New Batch Created</td>
                                <td>@DateTime.Now.ToString("dd-MMM-yyyy")</td>
                            </tr>

                            <tr>
                                <td>Teacher Assigned to Course</td>
                                <td>@DateTime.Now.ToString("dd-MMM-yyyy")</td>
                            </tr>

                            <tr>
                                <td>Student Fee Payment Received</td>
                                <td>@DateTime.Now.ToString("dd-MMM-yyyy")</td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>


        <!-- Quick Actions -->
        <div class="col-md-4">

            <div class="card">

                <div class="card-header">
                    <strong>Quick Actions</strong>
                </div>

                <div class="card-body d-grid gap-2">

                    <a href="#" class="btn btn-primary">
                        <i class="bi bi-person-plus"></i>
                        Add Student
                    </a>

                    <a href="#" class="btn btn-success">
                        <i class="bi bi-person-workspace"></i>
                        Add Teacher
                    </a>

                    <a href="#" class="btn btn-warning">
                        <i class="bi bi-journal-plus"></i>
                        Create Course
                    </a>

                    <a href="#" class="btn btn-info">
                        <i class="bi bi-collection"></i>
                        Create Batch
                    </a>

                    <a href="#" class="btn btn-secondary">
                        <i class="bi bi-cash-stack"></i>
                        Manage Fees
                    </a>

                    <a href="#" class="btn btn-dark">
                        <i class="bi bi-bar-chart"></i>
                        View Reports
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>