@{
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
}

<div class="IMS-shell">

    <!-- LEFT: School Management System brand / value -->
    <div class="panel-brand">

        <div class="brand-row">
            <div class="brand-mark">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <span class="brand-name">School MS</span>
        </div>

        <div class="hero-copy">
            <h1>
                Manage Your School,<br />
                <span class="accent">All in One Place.</span>
            </h1>

            <p>
                A unified platform to manage students, teachers, classes,
                attendance, examinations, fees, and secure access — all in one place.
            </p>
        </div>

        <div class="feature-list">

            <!-- Secure Access -->
            <div class="feature-item">
                <div class="feature-icon">
                    <i class="bi bi-shield-lock"></i>
                </div>

                <div>
                    <h6>Secure Access Control</h6>
                    <p>
                        Secure authentication and role-based access for administrators,
                        teachers, staff, students, and parents.
                    </p>
                </div>
            </div>

            <!-- Student Management -->
            <div class="feature-item">
                <div class="feature-icon">
                    <i class="bi bi-people"></i>
                </div>

                <div>
                    <h6>Student &amp; Academic Management</h6>
                    <p>
                        Manage student records, classes, sections, subjects,
                        teachers, and academic information efficiently.
                    </p>
                </div>
            </div>

            <!-- Attendance -->
            <div class="feature-item">
                <div class="feature-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>

                <div>
                    <h6>Smart School Operations</h6>
                    <p>
                        Track attendance, examinations, fees, and daily school
                        activities from one centralized system.
                    </p>
                </div>
            </div>

        </div>

        <div class="brand-footer">
            &copy; @DateTime.Now.Year School Management System. All rights reserved.
        </div>

    </div>


    <!-- RIGHT: Sign-in card -->
    <div class="panel-auth">

        <button type="button"
                class="theme-toggle"
                aria-label="Toggle theme">
            <i class="bi bi-moon-stars"></i>
        </button>

        <div class="auth-card">

            <div class="auth-logo">
                <i class="bi bi-mortarboard-fill"></i>
            </div>

            <h2>Welcome Back</h2>

            <p class="sub">
                Sign in to access your School Management System
            </p>

            <div class="sso-divider">
                <hr />
                <span>SECURE SIGN IN</span>
                <hr />
            </div>

            <a class="btn-keycloak" asp-controller="Home" asp-action="Login">

                <i class="bi bi-box-arrow-in-right"></i>
                Sign In to School Management System

            </a>

            <p class="auth-footnote">
                Authorized users only. Your connection is secure and monitored.
            </p>

        </div>

    </div>

</div>