@* IMS.Web/Views/Master/Index.cshtml *@
@model IMS.Models.Common.Master.MasterConfig
@{
    ViewData["Title"] = Model.DisplayName;
    var formFields = Model.Fields.Where(f => f.ShowInForm).ToList();
    var gridFields = Model.Fields.Where(f => f.ShowInGrid).ToList();
    var hasActiveColumn = !string.IsNullOrEmpty(Model.IsActiveColumn);
}
<link href="~/css/master.css" rel="stylesheet" />
<div class="master-page">
    <div class="master-header">
        <div>
            <h2>@Model.DisplayName</h2>
        </div>

        <button type="button" class="btn btn-master-add" id="btnAddNew">
            <i class="fa fa-plus"></i>
            <span>Add @Model.EntityType</span>
        </button>
    </div>

    <div class="master-card p-3">
        <table id="masterGrid" class="table master-table table-bordered w-100">
            <thead>
                <tr>
                    <th>Sr No.</th>

                    @foreach (var field in gridFields)
                    {
                        <th data-column="@field.ColumnName">
                            @field.DisplayName
                        </th>
                    }

                    @if (hasActiveColumn)
                    {
                        <th>Status</th>
                    }

                    <th>Action</th>
                </tr>
            </thead>

            <tbody></tbody>
        </table>
    </div>
</div>


