@using IMS.Models.Common.Master
@using IMS.Helpers.Constants
@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentEntityType = ViewContext.RouteData.Values["entityType"]?.ToString() ?? "";

    Func<string, string, string> isActive = (area, controller) =>
        string.Equals(currentArea, area, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "active" : "";

    var masterConfigs = MasterConfigRegistry.GetAll();
    var isMasterController = string.Equals(currentController, "Master", StringComparison.OrdinalIgnoreCase);
}

<aside class="IMS-sidebar" id="IMSSidebar">

    <!-- Brand -->
    <div class="IMS-sidebar-brand">
        <i class="fa-solid fa-graduation-cap IMS-brand-icon"></i>
        <span class="brand-text">IMS</span>
    </div>

    <nav class="IMS-nav">

        <!-- Dashboard -->
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link @isActive("", "Home")"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="fa-solid fa-gauge-high"></i>
                    <span>Dashboard</span>
                </a>
            </li>
        </ul>


        <!-- Academic Management -->
        <div class="nav-section-label">Academic Management</div>

        <ul class="nav flex-column">
            <permission-check code="@Permissions.ApproveTeacherLeave">
                <li class="nav-item">
                    <a class="nav-link @isActive("", "TeacherLeave")" asp-controller="TeacherLeave" asp-action="Index">
                        <i class="fa-solid fa-calendar-xmark"></i>
                        <span>Leave Requests</span>
                    </a>
                </li>
            </permission-check>

            <permission-check code="@Permissions.ApplyTeacherLeave">
                <li class="nav-item">
                    <a class="nav-link @isActive("", "TeacherLeave")" asp-controller="TeacherLeave" asp-action="MyLeave">
                        <i class="fa-solid fa-calendar-check"></i>
                        <span>My Leave</span>
                    </a>
                </li>
            </permission-check>

            <permission-check code="@Permissions.ManageTeacherAttendance">
                <li class="nav-item">
                    <a class="nav-link @isActive("", "TeacherAttendance")" asp-controller="TeacherAttendance" asp-action="Index">
                        <i class="fa-solid fa-calendar-check"></i>
                        <span>Teacher Attendance</span>
                    </a>
                </li>
            </permission-check>

            <permission-check code="@Permissions.ViewOwnTeacherAttendance">
                <li class="nav-item">
                    <a class="nav-link @isActive("", "TeacherAttendance")" asp-controller="TeacherAttendance" asp-action="TeacherAttendance">
                        <i class="fa-solid fa-calendar-week"></i>
                        <span>My Attendance</span>
                    </a>
                </li>
            </permission-check>

            <permission-check code="@Permissions.ViewTeacher">
                <li class="nav-item">
                    <a class="nav-link @isActive("Teacher", "Teacher")"
                       asp-controller="Teachers"
                       asp-action="Index">

                        <i class="fa-solid fa-file-lines"></i>
                        <span>Teachers</span>
                    </a>
                </li>
            </permission-check>

            <permission-check code="@Permissions.ViewStudent">
                <li class="nav-item">
                    <a class="nav-link @isActive("", "Students")"
                       asp-controller="Students"
                       asp-action="Index">
                        <i class="fa-solid fa-user-graduate"></i>
                        <span>Students</span>
                    </a>
                </li>
            </permission-check>

            <li class="nav-item">
                <a class="nav-link @isActive("", "StudentLeave")"
                   asp-controller="StudentLeave"
                   asp-action="Index">
                    <i class="fa-solid fa-user-clock"></i>
                    <span>Student Leaves</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "TransferCertificate")"
                   asp-controller="TransferCertificate"
                   asp-action="Index">
                    <i class="fa-solid fa-file-shield"></i>
                    <span>Transfer Certificates (TC)</span>
                </a>
            </li>
            @* <permission-check code="@Permissions.ViewStudentLeave">
                <li class="nav-item">
                    <a class="nav-link @isActive("", "StudentLeave")"
                       asp-controller="StudentLeave"
                       asp-action="Index">
                        <i class="fa-solid fa-user-clock"></i>
                        <span>Student Leaves</span>
                    </a>
                </li>
            </permission-check>

            <permission-check code="@Permissions.ViewTransferCertificate">
                <li class="nav-item">
                    <a class="nav-link @isActive("", "TransferCertificate")"
                       asp-controller="TransferCertificate"
                       asp-action="Index">
                        <i class="fa-solid fa-file-shield"></i>
                        <span>Transfer Certificates (TC)</span>
                    </a>
                </li>
            </permission-check> *@

            <li class="nav-item">
                <a class="nav-link @isActive("", "AdmissionApplication")"
                   asp-controller="AdmissionApplication"
                   asp-action="Index">
                    <i class="fa-solid fa-address-book"></i>
                    <span>Admissions</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "Staff")"
                   asp-controller="Staff"
                   asp-action="Index">

                    <i class="fa-solid fa-chalkboard-user"></i>
                    <span>Staff</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "CourseSubject")"
                   asp-controller="CourseSubject"
                   asp-action="Index">

                    <i class="fa-solid fa-link"></i>
                    <span>Course Subjects</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "Batch")"
                   asp-controller="Batch"
                   asp-action="Index">

                    <i class="fa-solid fa-users"></i>
                    <span>Batches</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "Enrollment")"
                   asp-controller="Enrollment"
                   asp-action="Index">

                    <i class="fa-solid fa-user-plus"></i>
                    <span>Enrollments</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "Timetable")"
                   asp-controller="Timetable"
                   asp-action="Index">

                    <i class="fa-solid fa-calendar-days"></i>
                    <span>Timetable</span>
                </a>
            </li>

        </ul>


        <!-- Institute Operations -->
        <div class="nav-section-label">Institute Operations</div>

        <ul class="nav flex-column">

            <li class="nav-item">
                <a class="nav-link @isActive("", "Attendance")"
                   asp-controller="Attendance"
                   asp-action="Index">

                    <i class="fa-solid fa-calendar-check"></i>
                    <span>Attendance</span>
                </a>
            </li>


            <li class="nav-item">
                <a class="nav-link @isActive("", "Fees")"
                   asp-controller="Fees"
                   asp-action="Index">

                    <i class="fa-solid fa-indian-rupee-sign"></i>
                    <span>Fees & Payments</span>
                </a>
            </li>


            <li class="nav-item">
                <a class="nav-link @isActive("", "Exam")"
                   asp-controller="Exam"
                   asp-action="Index">

                    <i class="fa-solid fa-file-pen"></i>
                    <span>Examinations</span>
                </a>
            </li>


            <li class="nav-item">
                <a class="nav-link @isActive("", "Expense")"
                   asp-controller="Expense"
                   asp-action="Index">

                    <i class="fa-solid fa-receipt"></i>
                    <span>Expenses</span>
                </a>
            </li>

        </ul>


        <!-- Administration & Master Management -->
        <div class="nav-section-label">Administration</div>

        <ul class="nav flex-column">

            <!-- Master Management Accordion / Sub-menu -->
            <li class="nav-item">
                <a class="nav-link d-flex align-items-center justify-content-between @(isMasterController ? "active" : "")"
                   data-bs-toggle="collapse"
                   href="#masterMenuCollapse"
                   role="button"
                   aria-expanded="@(isMasterController ? "true" : "false")"
                   aria-controls="masterMenuCollapse">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-database"></i>
                        <span>Master Management</span>
                    </div>
                    <i class="fa-solid fa-chevron-down IMS-menu-arrow"></i>
                </a>

                <div class="collapse @(isMasterController ? "show" : "")" id="masterMenuCollapse">
                    <ul class="nav flex-column ps-3 py-1 IMS-sub-nav">
                        <li class="nav-item">
                            <a class="nav-link sub-link @(isMasterController && string.IsNullOrEmpty(currentEntityType) ? "active" : "")"
                               href="/Master">
                                <i class="fa-solid fa-border-all me-2"></i>
                                <span>Master Overview</span>
                            </a>
                        </li>
                        @foreach (var master in masterConfigs)
                        {
                            var isThisMasterActive = isMasterController && string.Equals(currentEntityType, master.EntityType, StringComparison.OrdinalIgnoreCase);
                            <li class="nav-item">
                                <a class="nav-link sub-link @(isThisMasterActive ? "active" : "")"
                                   href="/Master/@master.EntityType">
                                    <i class="fa-solid @(string.IsNullOrEmpty(master.Icon) ? "fa-cube" : master.Icon) me-2"></i>
                                    <span>@master.DisplayName</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </li>

            <li class="nav-item">
                <a class="nav-link @isActive("", "DbTest")"
                   asp-area=""
                   asp-controller="DbTest"
                   asp-action="Index">

                    <i class="fa-solid fa-server"></i>
                    <span>Database Diagnostics</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link"
                   href="#">

                    <i class="fa-solid fa-user-shield"></i>
                    <span>Users & Roles</span>
                    <span class="IMS-soon-badge">Soon</span>
                </a>
            </li>

        </ul>


        <!-- Reports -->
        <div class="nav-section-label">Insights</div>

        <ul class="nav flex-column">

            <li class="nav-item">
                <a class="nav-link"
                   href="#">

                    <i class="fa-solid fa-chart-line"></i>
                    <span>Reports</span>
                    <span class="IMS-soon-badge">Soon</span>
                </a>
            </li>

        </ul>

    </nav>

</aside>
