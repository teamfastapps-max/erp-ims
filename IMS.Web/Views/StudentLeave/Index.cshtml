@model List<IMS.Models.Portal.StudentLeaveDto>
@{
    ViewData["Title"] = "Student Leave Applications";
    var currentStatus = ViewBag.CurrentStatus as string;
    var search = ViewBag.Search as string;
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-calendar-check text-primary me-2"></i>Student Leave Applications</h4>
        <p class="text-muted small mb-0">Review, approve, or reject student and guardian leave requests</p>
    </div>
</div>

@if (TempData["LoadError"] != null)
{
    <div class="alert alert-danger">@TempData["LoadError"]</div>
}

@Html.AntiForgeryToken()

<!-- Filters Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Search by student name or roll..." value="@search" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="Pending" selected="@(currentStatus == "Pending")">Pending Approval</option>
                    <option value="Approved" selected="@(currentStatus == "Approved")">Approved</option>
                    <option value="Rejected" selected="@(currentStatus == "Rejected")">Rejected</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 rounded-3">Filter</button>
            </div>
            <div class="col-md-2">
                <a href="@Url.Action("Index", "StudentLeave")" class="btn btn-outline-secondary w-100 rounded-3">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Applications Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Student</th>
                    <th>Leave Dates</th>
                    <th>Days</th>
                    <th>Type</th>
                    <th>Reason</th>
                    <th>Applied By</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody id="studentLeaveTableBody">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr id="leave-row-@item.LeaveId">
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@item.StudentName</div>
                                <div class="text-muted small">Roll: @(item.StudentCode ?? "N/A")</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@item.FromDate.ToString("dd MMM yyyy") - @item.ToDate.ToString("dd MMM yyyy")</div>
                                <div class="text-muted small" style="font-size: 0.72rem;">Applied: @item.AppliedAt.ToString("dd MMM, hh:mm tt")</div>
                            </td>
                            <td><span class="badge bg-light text-dark border">@item.TotalDays @(item.TotalDays > 1 ? "Days" : "Day")</span></td>
                            <td><span class="badge bg-primary-subtle text-primary">@item.LeaveType</span></td>
                            <td style="max-width: 250px;">
                                <div class="text-truncate" title="@item.Reason">@item.Reason</div>
                                @if (!string.IsNullOrEmpty(item.RejectionReason))
                                {
                                    <div class="text-danger small" style="font-size:0.72rem;">Remarks: @item.RejectionReason</div>
                                }
                            </td>
                            <td><span class="badge bg-secondary-subtle text-secondary">@item.AppliedBy</span></td>
                            <td>
                                @if (item.Status == "Approved")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">Approved</span>
                                }
                                else if (item.Status == "Rejected")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-1">Pending</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (item.Status == "Pending")
                                {
                                    <button class="btn btn-sm btn-success rounded-pill px-3 me-1 approve-leave-btn" data-id="@item.LeaveId">
                                        <i class="bi bi-check-lg me-1"></i>Approve
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3 me-1 open-reject-btn"
                                            data-id="@item.LeaveId" data-name="@item.StudentName"
                                            data-bs-toggle="modal" data-bs-target="#rejectModal">
                                        <i class="bi bi-x-lg me-1"></i>Reject
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 delete-leave-btn"
                                        data-id="@item.LeaveId" data-name="@item.StudentName" title="Delete Leave Record">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                            No leave applications found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(page <= 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { status = currentStatus, search, page = page - 1 })">Previous</a>
            </li>
            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { status = currentStatus, search, page = p })">@p</a>
                </li>
            }
            <li class="page-item @(page >= totalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { status = currentStatus, search, page = page + 1 })">Next</a>
            </li>
        </ul>
    </nav>
}

<!-- Reject Modal (single shared modal, reused for every row) -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-x-circle me-2"></i>Reject Leave Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <input type="hidden" id="rejectLeaveId" />
                <p class="text-muted small">Provide a reason for rejecting the leave request for <strong id="rejectStudentName"></strong>.</p>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Rejection Reason</label>
                    <textarea id="rejectionReasonInput" class="form-control rounded-3" rows="3" placeholder="Enter reason (e.g. exams scheduled, invalid dates)..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmRejectBtn" class="btn btn-danger rounded-pill px-4">Confirm Rejection</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteLeaveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-trash me-2"></i>Delete Leave Application</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <input type="hidden" id="deleteLeaveId" />
                <p class="text-muted mb-0">Are you sure you want to permanently delete the leave application for <strong id="deleteStudentName"></strong>?</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmDeleteLeaveBtn" class="btn btn-danger rounded-pill px-4">Delete Record</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/studentLeave.js"></script>
}
