@model IMS.Models.ViewModels.BatchFormViewModel
@{
    ViewData["Title"] = "Create Batch";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-users me-2"></i>Create Batch</h3>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form id="batchCreateForm" asp-controller="Batch" asp-action="AddBatch" method="post">
            @Html.AntiForgeryToken()
            <partial name="_Form" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/common/datepicker.js"></script>
    <script src="~/js/batches.js"></script>
    <script>
        $(function () {
            IMSBatchForm.init('/Batch/AddBatch');
            IMSDatePicker.init({ input: '#BT_StartDate', format: 'dd/MM/yyyy', valueFormat: 'yyyy-MM-dd', placeholder: 'DD/MM/YYYY', allowFutureDates: false });
            IMSDatePicker.init({ input: '#BT_EndDate', format: 'dd/MM/yyyy', valueFormat: 'yyyy-MM-dd', placeholder: 'DD/MM/YYYY' });
        });
    </script>
}
