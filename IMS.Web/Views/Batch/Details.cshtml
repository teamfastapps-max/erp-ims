@model IMS.Models.ViewModels.BatchDetailsViewModel
@{
    ViewData["Title"] = "Batch Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-users me-2"></i>@Model.BT_Name</h3>
    <div>
        <a asp-controller="Batch" asp-action="Edit" asp-route-id="@Model.BT_Id" class="btn btn-outline-primary">
            <i class="fa-solid fa-pen me-1"></i> Edit
        </a>
        <a asp-controller="Batch" asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header"><h5 class="mb-0">Batch Information</h5></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Batch Code</dt>
                    <dd class="col-sm-8">@Model.BT_Code</dd>
                    <dt class="col-sm-4">Branch</dt>
                    <dd class="col-sm-8">@Model.BranchName</dd>
                    <dt class="col-sm-4">Course</dt>
                    <dd class="col-sm-8">@Model.CourseName</dd>
                    <dt class="col-sm-4">Academic Year</dt>
                    <dd class="col-sm-8">@Model.AcademicYearName</dd>
                    <dt class="col-sm-4">Start Date</dt>
                    <dd class="col-sm-8">@Model.BT_StartDate.ToString("dd-MMM-yyyy")</dd>
                    <dt class="col-sm-4">End Date</dt>
                    <dd class="col-sm-8">@(Model.BT_EndDate?.ToString("dd-MMM-yyyy") ?? "-")</dd>
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8"><span class="badge @StatusBadgeClass(Model.BT_Status)">@Model.BT_Status</span></dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header"><h5 class="mb-0">Enrollment</h5></div>
            <div class="card-body text-center">
                <h2 class="mb-1">@Model.EnrolledCount</h2>
                <p class="text-muted mb-0">
                    students enrolled
                    @if (Model.BT_Capacity.HasValue)
                    {
                        <span>out of @Model.BT_Capacity</span>
                    }
                </p>
            </div>
        </div>
        <div class="card shadow-sm mt-3">
            <div class="card-header"><h5 class="mb-0">Metadata</h5></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Created</dt>
                    <dd class="col-sm-7">@Model.BT_CreatedAt.ToString("dd-MMM-yyyy HH:mm")</dd>
                    <dt class="col-sm-5">Updated</dt>
                    <dd class="col-sm-7">@Model.BT_UpdatedAt.ToString("dd-MMM-yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

@functions {
    string StatusBadgeClass(string status) => status switch
    {
        "Active" => "bg-success",
        "Completed" => "bg-info text-dark",
        "Cancelled" => "bg-danger",
        _ => "bg-light text-dark"
    };
}
