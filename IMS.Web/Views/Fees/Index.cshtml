@model IMS.Models.ViewModels.FeeStructureIndexViewModel
@{ ViewData["Title"] = "Fee Structures"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-indian-rupee-sign me-2"></i>Fee Structures</h3>
    <a asp-controller="Fees" asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Add Fee Structure</a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Index", "Fees", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-4">
                @Html.Label("searchTerm", "Search", new { @class = "form-label" })
                @Html.TextBox("searchTerm", Model.SearchTerm, new { @class = "form-control", placeholder = "Name or code" })
            </div>
            <div class="col-md-3">
                @Html.Label("academicYearId", "Academic Year", new { @class = "form-label" })
                @Html.DropDownList("academicYearId", Model.AcademicYearOptions, "All Years", new { @class = "form-select" })
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-primary"><i class="fa-solid fa-search me-1"></i> Filter</button>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive p-3">
        <table id="dataTable" class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Code</th><th>Name</th><th>Course</th><th>Batch</th><th>Year</th><th>Active</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @if (!Model.FeeStructures.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No fee structures found.</td></tr> }
                else {
                    foreach (var f in Model.FeeStructures)
                    {
                        <tr id="fs-row-@f.FS_Id">
                            <td>@f.FS_Code</td><td>@f.FS_Name</td><td>@f.CourseName</td><td>@f.BatchName</td><td>@f.AcademicYearName</td>
                            <td><span class="badge @(f.FS_IsActive ? "bg-success" : "bg-secondary")">@(f.FS_IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-end">
                                <a asp-controller="Fees" asp-action="Edit" asp-route-id="@f.FS_Id" class="btn btn-sm btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger confirm-delete-btn" data-id="@f.FS_Id" data-bs-toggle="modal" data-bs-target="#deleteModal-@f.FS_Id"><i class="fa-solid fa-trash"></i></button>
                                <div class="modal fade" id="deleteModal-@f.FS_Id" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
                                    <div class="modal-header"><h5 class="modal-title">Delete Fee Structure</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                                    <div class="modal-body">Are you sure you want to delete <strong>@f.FS_Name</strong>?</div>
                                    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-danger do-delete-btn">Delete</button></div>
                                </div></div></div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts { <script src="~/js/fees.js"></script>
<script>$(function () { $('#dataTable').DataTable({ pageLength: 10, lengthMenu: [10, 25, 50, 100], order: [[0, 'asc']] }); });</script>
}
