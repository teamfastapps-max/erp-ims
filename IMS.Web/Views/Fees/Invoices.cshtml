@model IMS.Models.ViewModels.FeeInvoiceIndexViewModel
@{ ViewData["Title"] = "Fee Invoices"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-file-invoice me-2"></i>Fee Invoices</h3>
    <a asp-controller="Fees" asp-action="CreateInvoice" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Create Invoice</a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Invoices", "Fees", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-4">
                @Html.Label("searchTerm", "Search", new { @class = "form-label" })
                @Html.TextBox("searchTerm", Model.SearchTerm, new { @class = "form-control", placeholder = "Invoice or student" })
            </div>
            <div class="col-md-2">
                @Html.Label("status", "Status", new { @class = "form-label" })
                @Html.DropDownList("status", Model.StatusOptions, "All Statuses", new { @class = "form-select" })
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-primary"><i class="fa-solid fa-search me-1"></i> Filter</button>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Invoice #</th><th>Student</th><th>Date</th><th>Due Date</th><th>Total</th><th>Paid</th><th>Balance</th><th>Status</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @if (!Model.Invoices.Any()) { <tr><td colspan="9" class="text-center text-muted py-4">No invoices found.</td></tr> }
                else {
                    foreach (var inv in Model.Invoices)
                    {
                        <tr id="fi-row-@inv.FI_Id">
                            <td>@inv.FI_InvoiceNumber</td><td>@inv.StudentCode - @inv.StudentName</td>
                            <td>@inv.FI_InvoiceDate.ToString("dd-MMM-yyyy")</td><td>@inv.FI_DueDate.ToString("dd-MMM-yyyy")</td>
                            <td>@inv.FI_TotalAmount.ToString("N2")</td><td>@inv.FI_PaidAmount.ToString("N2")</td><td>@inv.FI_BalanceAmount.ToString("N2")</td>
                            <td><span class="badge @InvoiceStatusBadge(inv.FI_Status)">@inv.FI_Status</span></td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-danger confirm-delete-btn" data-id="@inv.FI_Id" data-bs-toggle="modal" data-bs-target="#deleteModal-@inv.FI_Id"><i class="fa-solid fa-trash"></i></button>
                                <div class="modal fade" id="deleteModal-@inv.FI_Id" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
                                    <div class="modal-header"><h5 class="modal-title">Delete Invoice</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                                    <div class="modal-body">Delete invoice <strong>@inv.FI_InvoiceNumber</strong>?</div>
                                    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-danger do-delete-btn">Delete</button></div>
                                </div></div></div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()
@if (Model.TotalPages > 1) { <nav class="mt-3"><ul class="pagination justify-content-center">
    @for (int p = 1; p <= Model.TotalPages; p++) { <li class="page-item @(p == Model.PageNumber ? "active" : "")"><a class="page-link" href="@Url.Action("Invoices", "Fees", new { searchTerm = Model.SearchTerm, status = Model.StatusFilter, page = p })">@p</a></li> }
</ul></nav> }

@functions { string InvoiceStatusBadge(string s) => s switch { "Paid" => "bg-success", "Pending" => "bg-warning text-dark", "Partial" => "bg-info text-dark", "Overdue" => "bg-danger", _ => "bg-secondary" }; }

@section Scripts { <script src="~/js/fees.js"></script> }
