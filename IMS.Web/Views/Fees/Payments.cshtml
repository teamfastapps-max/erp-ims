@model IMS.Models.ViewModels.PaymentIndexViewModel
@{ ViewData["Title"] = "Payments"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-money-bill me-2"></i>Payments</h3>
    <a asp-controller="Fees" asp-action="CreatePayment" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Record Payment</a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Payments", "Fees", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-4">
                @Html.Label("searchTerm", "Search", new { @class = "form-label" })
                @Html.TextBox("searchTerm", Model.SearchTerm, new { @class = "form-control", placeholder = "Payment or student" })
            </div>
            <div class="col-md-2">
                @Html.Label("status", "Status", new { @class = "form-label" })
                @Html.DropDownList("status", Model.StatusOptions, "All Statuses", new { @class = "form-select" })
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-primary"><i class="fa-solid fa-search me-1"></i> Filter</button>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Payment #</th><th>Student</th><th>Date</th><th>Amount</th><th>Method</th><th>Status</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @if (!Model.Payments.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No payments found.</td></tr> }
                else {
                    foreach (var p in Model.Payments)
                    {
                        <tr id="pay-row-@p.PAY_Id">
                            <td>@p.PAY_PaymentNumber</td><td>@p.StudentCode - @p.StudentName</td>
                            <td>@p.PAY_PaymentDate.ToString("dd-MMM-yyyy")</td><td>@p.PAY_Amount.ToString("N2")</td>
                            <td>@p.PaymentMethodName</td>
                            <td><span class="badge @PaymentStatusBadge(p.PAY_Status)">@p.PAY_Status</span></td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-danger confirm-delete-btn" data-id="@p.PAY_Id" data-bs-toggle="modal" data-bs-target="#deleteModal-@p.PAY_Id"><i class="fa-solid fa-trash"></i></button>
                                <div class="modal fade" id="deleteModal-@p.PAY_Id" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
                                    <div class="modal-header"><h5 class="modal-title">Delete Payment</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                                    <div class="modal-body">Delete payment <strong>@p.PAY_PaymentNumber</strong>?</div>
                                    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-danger do-delete-btn">Delete</button></div>
                                </div></div></div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()
@if (Model.TotalPages > 1) { <nav class="mt-3"><ul class="pagination justify-content-center">
    @for (int p = 1; p <= Model.TotalPages; p++) { <li class="page-item @(p == Model.PageNumber ? "active" : "")"><a class="page-link" href="@Url.Action("Payments", "Fees", new { searchTerm = Model.SearchTerm, status = Model.StatusFilter, page = p })">@p</a></li> }
</ul></nav> }

@functions { string PaymentStatusBadge(string s) => s switch { "Completed" => "bg-success", "Pending" => "bg-warning text-dark", "Failed" => "bg-danger", "Refunded" => "bg-info text-dark", _ => "bg-secondary" }; }

@section Scripts { <script src="~/js/fees.js"></script> }
