@model IMS.Models.ViewModels.TimetableFormViewModel
@{ ViewData["Title"] = "Edit Timetable Entry"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-calendar-days me-2"></i>Edit Timetable Entry</h3>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form id="ttEditForm" asp-controller="Timetable" asp-action="EditTimetable" method="post">
            @Html.AntiForgeryToken()
            <partial name="_Form" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
<script src="~/js/common/datepicker.js"></script>
<script>
$(function () {
    IMSDatePicker.init({ input: '#TT_EffectiveFrom', format: 'dd/MM/yyyy', valueFormat: 'yyyy-MM-dd', placeholder: 'DD/MM/YYYY' });
    IMSDatePicker.init({ input: '#TT_EffectiveTo', format: 'dd/MM/yyyy', valueFormat: 'yyyy-MM-dd', placeholder: 'DD/MM/YYYY' });

    $('.select2-staff').select2({
        theme: 'bootstrap-5',
        width: '100%',
        placeholder: 'Type to search staff...',
        allowClear: true,
        minimumInputLength: 0
    });

    $("form").on("submit", function (e) {
        e.preventDefault();
        var $form = $(this), $btn = $form.find("button[type='submit']");
        $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-1"></span> Saving...');
        $.ajax({ url: $form.attr("action"), type: "POST", data: $form.serialize(),
            success: function (r) { if (r.success) { if (window.toastr) toastr.success(r.message); setTimeout(function(){window.location.href="/Timetable/Index";},700); } else { if (window.toastr) toastr.error(r.message); $btn.prop("disabled", false).html('<i class="fa-solid fa-check me-1"></i> Save Entry'); } },
            error: function () { if (window.toastr) toastr.error("Request failed."); $btn.prop("disabled", false).html('<i class="fa-solid fa-check me-1"></i> Save Entry'); }
        });
    });
});
</script>
}
