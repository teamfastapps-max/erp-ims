@model IMS.Models.ViewModels.CourseSubjectFormViewModel

<div class="row g-3">
    <div class="col-md-6">
        <label for="CS_CourseId" class="form-label">Course <span class="text-danger">*</span></label>
        @Html.DropDownListFor(m => m.CS_CourseId, Model.CourseOptions, "Select Course", new { @class = "form-select" })
        <div class="text-danger small field-error" data-for="CS_CourseId"></div>
    </div>
    <div class="col-md-6">
        <label for="CS_SubjectId" class="form-label">Subject <span class="text-danger">*</span></label>
        @Html.DropDownListFor(m => m.CS_SubjectId, Model.SubjectOptions, "Select Subject", new { @class = "form-select" })
        <div class="text-danger small field-error" data-for="CS_SubjectId"></div>
    </div>
    <div class="col-md-4">
        <label for="CS_SequenceNo" class="form-label">Sequence No.</label>
        @Html.TextBoxFor(m => m.CS_SequenceNo, new { @class = "form-control", type = "number", min = "1" })
    </div>
    <div class="col-md-4">
        <label for="CS_MaxMarks" class="form-label">Max Marks</label>
        @Html.TextBoxFor(m => m.CS_MaxMarks, new { @class = "form-control", type = "number", step = "0.01" })
    </div>
    <div class="col-md-4">
        <label for="CS_PassMarks" class="form-label">Pass Marks</label>
        @Html.TextBoxFor(m => m.CS_PassMarks, new { @class = "form-control", type = "number", step = "0.01" })
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check">
            @Html.CheckBoxFor(m => m.CS_IsMandatory, new { @class = "form-check-input" })
            <label class="form-check-label">Mandatory</label>
        </div>
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mt-4">
    <a asp-controller="CourseSubject" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i> Save</button>
</div>
