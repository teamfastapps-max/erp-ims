@model IMS.Models.ViewModels.CourseSubjectFormViewModel
@{ ViewData["Title"] = "Edit Course Subject"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-book me-2"></i>Edit Course Subject</h3>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form id="csEditForm" asp-controller="CourseSubject" asp-action="EditCourseSubject" method="post">
            @Html.AntiForgeryToken()
            <partial name="_Form" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $("form").on("submit", function (e) {
                e.preventDefault();
                var $form = $(this);
                var $btn = $form.find("button[type='submit']");
                $btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-1"></span> Saving...');
                $.ajax({ url: $form.attr("action"), type: "POST", data: $form.serialize(),
                    success: function (r) {
                        if (r.success) { if (window.toastr) toastr.success(r.message); setTimeout(function () { window.location.href = "/CourseSubject/Index"; }, 700); }
                        else { if (window.toastr) toastr.error(r.message); $btn.prop("disabled", false).html('<i class="fa-solid fa-check me-1"></i> Save'); }
                    },
                    error: function () { if (window.toastr) toastr.error("Request failed."); $btn.prop("disabled", false).html('<i class="fa-solid fa-check me-1"></i> Save'); }
                });
            });
        });
    </script>
}
