@using IMS.Web.Controllers
@model List<VendorTestItem>

@{
    ViewData["Title"] = "DB Test - Vendors";
}

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="fa-solid fa-database me-2"></i>Vendors_V Table</h4>
            <span class="badge bg-light text-dark">@Model.Count record(s)</span>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-action="Create" method="post" class="row g-2 align-items-end border rounded p-3 bg-light mb-4">
                @Html.AntiForgeryToken()
                <div class="col-md-3">
                    <label class="form-label fw-bold small">Vendor Code</label>
                    <input name="vendorCode" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold small">Vendor Name</label>
                    <input name="vendorName" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small">Tax Number</label>
                    <input name="taxNumber" class="form-control" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-success w-100">
                        <i class="fa fa-plus"></i> Add
                    </button>
                </div>
            </form>

            @if (Model.Count == 0)
            {
                <div class="alert alert-info">No records found in Vendors_V table.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-sm align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Vendor Code</th>
                                <th>Vendor Name</th>
                                <th>Tax No.</th>
                                <th>Active</th>
                                <th>Created</th>
                                <th>Modified</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var v = Model[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td><code>@v.VendorCode</code></td>
                                    <td>@v.VendorName</td>
                                    <td>@(v.TaxNumber ?? "-")</td>
                                    <td>
                                        @if (v.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>@v.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@(v.ModifiedDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                    <td>
                                        <form asp-action="Delete" method="post" onsubmit="return confirm('Delete @v.VendorCode?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@v.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="card-footer text-muted small">
            Query: <code>SELECT FROM Vendors_V ORDER BY V_Id DESC</code>
        </div>
    </div>
</div>
