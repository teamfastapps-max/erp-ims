@model IMS.Models.ViewModels.AttendanceSessionFormViewModel
@{ ViewData["Title"] = "Edit Attendance Session"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-calendar-check me-2"></i>Edit Attendance Session</h3>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form id="attendanceEditForm" asp-controller="Attendance" asp-action="EditSession" method="post">
            @Html.AntiForgeryToken()
            <partial name="_Form" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/common/datepicker.js"></script>
    <script src="~/js/attendance.js"></script>
    <script>
        $(function () {
            IMSAttendanceSessionForm.init('/Attendance/EditSession');
            IMSDatePicker.init({ input: '#AS_AttendanceDate', format: 'dd/MM/yyyy', valueFormat: 'yyyy-MM-dd', placeholder: 'DD/MM/YYYY' });
        });
    </script>
}
