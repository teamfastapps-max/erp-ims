@model IMS.Models.ViewModels.AttendanceSessionIndexViewModel
@{
    ViewData["Title"] = "Student Attendance";
}

@section Styles {
    <link rel="stylesheet" href="~/css/attendance.css" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h3 class="mb-1 fw-bold text-dark">
            <i class="fa-solid fa-calendar-check text-primary me-2"></i>Student Attendance Hub
        </h3>
        <p class="text-muted small mb-0">Record, track, and monitor daily classroom student attendance sessions.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="Attendance" asp-action="Create" class="btn btn-primary shadow-sm px-3">
            <i class="fa-solid fa-plus me-1"></i> New Attendance Session
        </a>
    </div>
</div>

<!-- Attendance KPI Summary Metrics -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="attendance-stat-box d-flex align-items-center gap-3">
            <div class="stat-icon stat-icon-total">
                <i class="fa-solid fa-chalkboard-user"></i>
            </div>
            <div>
                <div class="stat-number text-dark">@Model.TotalSessionsCount</div>
                <div class="stat-label">Sessions Listed</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="attendance-stat-box d-flex align-items-center gap-3">
            <div class="stat-icon stat-icon-present">
                <i class="fa-solid fa-user-check"></i>
            </div>
            <div>
                <div class="stat-number text-success">@Model.TotalPresentCount</div>
                <div class="stat-label">Total Present</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="attendance-stat-box d-flex align-items-center gap-3">
            <div class="stat-icon stat-icon-absent">
                <i class="fa-solid fa-user-xmark"></i>
            </div>
            <div>
                <div class="stat-number text-danger">@Model.TotalAbsentCount</div>
                <div class="stat-label">Total Absences</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="attendance-stat-box d-flex align-items-center gap-3">
            <div class="stat-icon stat-icon-late">
                <i class="fa-solid fa-chart-pie"></i>
            </div>
            <div>
                <div class="stat-number text-primary">@Model.OverallAttendanceRate%</div>
                <div class="stat-label">Avg Attendance</div>
            </div>
        </div>
    </div>
</div>

<!-- Filters Card -->
<div class="card shadow-sm border-0 mb-4" style="border-radius: 0.85rem;">
    <div class="card-body p-3">
        @using (Html.BeginForm("Index", "Attendance", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-3">
                <label for="searchTerm" class="form-label text-muted small fw-semibold">Search</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="searchTerm" class="form-control border-start-0 ps-0" placeholder="Batch or subject..." value="@Model.SearchTerm" />
                </div>
            </div>
            <div class="col-md-3">
                <label for="filterBranchId" class="form-label text-muted small fw-semibold">Branch</label>
                <select name="branchId" id="filterBranchId" class="form-select form-select-sm" data-selected-value="@(Model.BranchFilter?.ToString())">
                </select>
            </div>
            <div class="col-md-2">
                <label for="filterDate" class="form-label text-muted small fw-semibold">Session Date</label>
                <input type="text" id="filterDate" name="date" class="form-control form-control-sm ims-datepicker-input" value="@(Model.DateFilter?.ToString("yyyy-MM-dd"))" placeholder="YYYY-MM-DD" />
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-sm btn-outline-primary">
                    <i class="fa-solid fa-filter me-1"></i> Apply Filter
                </button>
            </div>
            <div class="col-md-2 d-grid">
                <a asp-controller="Attendance" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="fa-solid fa-rotate-left me-1"></i> Reset
                </a>
            </div>
        }
    </div>
</div>

<!-- Sessions Table Card -->
<div class="card shadow-sm border-0 mb-4" style="border-radius: 0.85rem; overflow: hidden;">
    <div class="table-responsive p-3">
        <table id="dataTable" class="table table-hover align-middle mb-0">
            <thead class="table-light text-muted small text-uppercase">
                <tr>
                    <th>Date</th>
                    <th>Batch</th>
                    <th>Subject</th>
                    <th>Faculty / Staff</th>
                    <th>Time Window</th>
                    <th class="text-center">Present / Total</th>
                    <th class="text-center">Rate</th>
                    <th class="text-end" style="min-width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Sessions)
                {
                    var rate = s.TotalStudents > 0 ? Math.Round((double)s.PresentCount / s.TotalStudents * 100) : 0;
                    <tr id="session-row-@s.AS_Id">
                        <td>
                            <div class="fw-semibold text-dark">@s.AS_AttendanceDate.ToString("dd-MMM-yyyy")</div>
                            <div class="text-muted small">@s.AS_AttendanceDate.ToString("dddd")</div>
                        </td>
                        <td>
                            <span class="badge bg-primary-subtle text-primary fw-bold px-2 py-1">
                                <i class="fa-solid fa-users me-1"></i>@s.BatchName
                            </span>
                        </td>
                        <td>
                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(s.SubjectName) || s.SubjectName == "-" ? "General Class" : s.SubjectName)</div>
                        </td>
                        <td>
                            <div class="text-muted small">
                                <i class="fa-solid fa-user-tie me-1 text-secondary opacity-75"></i>@s.StaffName
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(s.AS_StartTime) && s.AS_StartTime != "-")
                            {
                                <span class="badge bg-light text-dark border">
                                    <i class="fa-solid fa-clock me-1 text-muted"></i>@s.AS_StartTime - @s.AS_EndTime
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">All Day</span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge bg-success-subtle text-success fw-bold px-2 py-1">@s.PresentCount Present</span>
                            @if (s.AbsentCount > 0)
                            {
                                <span class="badge bg-danger-subtle text-danger fw-bold px-2 py-1 ms-1">@s.AbsentCount Absent</span>
                            }
                        </td>
                        <td class="text-center" style="width: 120px;">
                            <div class="d-flex align-items-center gap-2 justify-content-center">
                                <span class="small fw-bold text-dark">@rate%</span>
                            </div>
                            <div class="attendance-rate-bar mt-1">
                                <div class="attendance-rate-bar-fill" style="width: @rate%;"></div>
                            </div>
                        </td>
                        <td class="text-end">
                            <a asp-controller="Attendance" asp-action="MarkAttendance" asp-route-id="@s.AS_Id"
                               class="btn btn-sm btn-success px-2 py-1 shadow-sm" title="Mark / Edit Attendance Sheet">
                                <i class="fa-solid fa-clipboard-check me-1"></i> Mark
                            </a>
                            <a asp-controller="Attendance" asp-action="Edit" asp-route-id="@s.AS_Id"
                               class="btn btn-sm btn-outline-primary px-2 py-1" title="Edit Session Details">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-danger px-2 py-1 delete-session-btn"
                                    data-id="@s.AS_Id" 
                                    data-batch="@s.BatchName" 
                                    data-date="@s.AS_AttendanceDate.ToString("dd-MMM-yyyy")" 
                                    title="Delete Session">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/attendance.js"></script>
    <script>
        $(function () {
            $('#dataTable').DataTable({ 
                pageLength: 10, 
                lengthMenu: [10, 25, 50, 100], 
                order: [[0, 'desc']] 
            });
            Dropdown.load({ 
                element: '#filterBranchId', 
                entityType: 'Branch', 
                defaultText: 'All Branches', 
                includeDefault: true, 
                selectedValue: $('#filterBranchId').data('selected-value') 
            });
            IMSDatePicker.init('#filterDate');
        });
    </script>
}
