@model IMS.Models.ViewModels.ExamFormViewModel
@{ ViewData["Title"] = "Create Exam"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-file-pen me-2"></i>Create Exam</h3>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form id="examCreateForm" asp-controller="Exam" asp-action="AddExam" method="post">
            @Html.AntiForgeryToken()
            <partial name="_Form" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/common/datepicker.js"></script>
    <script src="~/js/exams.js"></script>
    <script>
        $(function () {
            IMSExamForm.init('/Exam/AddExam');
            IMSDatePicker.init({ input: '#EX_StartDate', format: 'dd/MM/yyyy', valueFormat: 'yyyy-MM-dd', placeholder: 'DD/MM/YYYY' });
            IMSDatePicker.init({ input: '#EX_EndDate', format: 'dd/MM/yyyy', valueFormat: 'yyyy-MM-dd', placeholder: 'DD/MM/YYYY' });
        });
    </script>
}
