@model IMS.Models.ViewModels.MarksEntryViewModel
@{ ViewData["Title"] = "Marks Entry"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-pen-to-square me-2"></i>Marks Entry</h3>
    <a asp-controller="Exam" asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label text-muted">Exam</label>
                <div class="fw-semibold">@Model.ExamCode - @Model.ExamName</div>
            </div>
        </div>
    </div>
</div>

<form id="marksEntryForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ExamId" value="@Model.ExamId" />

    @for (int si = 0; si < Model.Subjects.Count; si++)
    {
        var subject = Model.Subjects[si];
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0">@subject.SubjectName (Max: @subject.MaxMarks, Pass: @subject.PassMarks)</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Student</th>
                            <th style="width:150px">Marks Obtained</th>
                            <th style="width:200px">Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < subject.Students.Count; i++)
                        {
                            var student = subject.Students[i];
                            <tr>
                                <td>@student.StudentCode</td>
                                <td>@student.StudentName</td>
                                <td>
                                    <input type="number" name="Subjects[@si].Students[@i].MarksObtained"
                                           class="form-control form-control-sm" min="0" max="@subject.MaxMarks" step="0.01"
                                           value="@student.MarksObtained" />
                                    <input type="hidden" name="Subjects[@si].Students[@i].StudentId" value="@student.StudentId" />
                                </td>
                                <td>
                                    <input type="text" name="Subjects[@si].Students[@i].Remarks"
                                           class="form-control form-control-sm" value="@student.Remarks" placeholder="Optional" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="d-flex justify-content-end gap-2 mt-4 mb-4">
        <button type="button" id="saveMarksBtn" class="btn btn-primary">
            <i class="fa-solid fa-check me-1"></i> Save Marks
        </button>
    </div>
</form>

@section Scripts {
    <script src="~/js/exams.js"></script>
    <script>
        $(function () {
            IMSMarksEntry.init('@Model.ExamId');
        });
    </script>
}
