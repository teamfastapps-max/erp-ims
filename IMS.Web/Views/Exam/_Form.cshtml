@model IMS.Models.ViewModels.ExamFormViewModel

@if (Model.EX_Id.HasValue)
{
    @Html.HiddenFor(m => m.EX_Id)
}

<div class="row g-3">
    <div class="col-md-6">
        <label for="EX_Name" class="form-label">Exam Name <span class="text-danger">*</span></label>
        @Html.TextBoxFor(m => m.EX_Name, new { @class = "form-control", placeholder = "e.g. Mid-Term Exam" })
        <div class="text-danger small field-error" data-for="EX_Name"></div>
    </div>
    <div class="col-md-6">
        <label for="EX_Code" class="form-label">Exam Code <span class="text-danger">*</span></label>
        @Html.TextBoxFor(m => m.EX_Code, new { @class = "form-control", placeholder = "e.g. EX-001" })
        <div class="text-danger small field-error" data-for="EX_Code"></div>
    </div>
    <div class="col-md-4">
        <label for="EX_AcademicYearId" class="form-label">Academic Year <span class="text-danger">*</span></label>
        @Html.DropDownListFor(m => m.EX_AcademicYearId, Model.AcademicYearOptions, "Select Year", new { @class = "form-select" })
        <div class="text-danger small field-error" data-for="EX_AcademicYearId"></div>
    </div>
    <div class="col-md-4">
        <label for="EX_CourseId" class="form-label">Course <span class="text-danger">*</span></label>
        @Html.DropDownListFor(m => m.EX_CourseId, Model.CourseOptions, "Select Course", new { @class = "form-select" })
        <div class="text-danger small field-error" data-for="EX_CourseId"></div>
    </div>
    <div class="col-md-4">
        <label for="EX_BatchId" class="form-label">Batch <span class="text-danger">*</span></label>
        @Html.DropDownListFor(m => m.EX_BatchId, Model.BatchOptions, "Select Batch", new { @class = "form-select" })
        <div class="text-danger small field-error" data-for="EX_BatchId"></div>
    </div>
    <div class="col-md-4">
        <label for="EX_ExamTypeId" class="form-label">Exam Type <span class="text-danger">*</span></label>
        @Html.DropDownListFor(m => m.EX_ExamTypeId, Model.ExamTypeOptions, "Select Type", new { @class = "form-select" })
        <div class="text-danger small field-error" data-for="EX_ExamTypeId"></div>
    </div>
    <div class="col-md-4">
        <label for="EX_StartDate" class="form-label">Start Date <span class="text-danger">*</span></label>
        @Html.TextBoxFor(m => m.EX_StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control ims-datepicker-input", placeholder = "DD/MM/YYYY", @id = "EX_StartDate" })
    </div>
    <div class="col-md-4">
        <label for="EX_EndDate" class="form-label">End Date <span class="text-danger">*</span></label>
        @Html.TextBoxFor(m => m.EX_EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control ims-datepicker-input", placeholder = "DD/MM/YYYY", @id = "EX_EndDate" })
    </div>
    <div class="col-md-4">
        <label for="EX_Status" class="form-label">Status <span class="text-danger">*</span></label>
        @Html.DropDownListFor(m => m.EX_Status, Model.StatusOptions, new { @class = "form-select" })
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mt-4">
    <a asp-controller="Exam" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary">
        <i class="fa-solid fa-check me-1"></i> Save Exam
    </button>
</div>
