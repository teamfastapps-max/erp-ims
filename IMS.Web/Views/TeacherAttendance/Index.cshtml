@model IMS.Models.ViewModels.TeacherAttendanceMarkTodayViewModel
@{
    ViewData["Title"] = "Mark Attendance";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-calendar-check me-2"></i>Mark Attendance</h3>
    <div>
        <label class="form-label me-2 mb-0">Date</label>
        <input type="date" id="attendanceDatePicker" class="form-control d-inline-block w-auto"
               value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
    </div>
</div>

@Html.AntiForgeryToken()

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Teacher</th><th style="width:180px">Status</th><th>Remarks</th><th class="text-end" style="width:80px">Save</th></tr>
            </thead>
            <tbody>
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">No active teachers found.</td></tr>
                }
                else
                {
                    foreach (var row in Model.Rows)
                    {
                        <tr data-teacher-id="@row.TeacherId">
                            <td>
                                @row.TeacherName
                                @if (row.IsOnLeaveToday)
                                {
                                    <span class="badge bg-info text-dark ms-2">On Leave</span>
                                }
                            </td>
                            <td>
                                <select class="form-select form-select-sm attendance-status-select" @(row.IsOnLeaveToday ? "disabled" : "")>
                                    <option value="">-- Select --</option>
                                    @foreach (var status in IMS.Helpers.Constants.TeacherHrOptions.AttendanceStatuses)
                                    {
                                        <option value="@status" selected="@(status == row.CurrentStatus)">@status</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input type="text" class="form-control form-control-sm attendance-remarks-input" value="@row.Remarks" @(row.IsOnLeaveToday ? "disabled" : "") />
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-primary mark-attendance-btn" @(row.IsOnLeaveToday ? "disabled" : "")>
                                    <i class="bi bi-check-lg"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/teacherHr.css" />
    <script src="~/js/teacherAttendance.js"></script>
}
