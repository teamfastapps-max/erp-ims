@model IMS.Models.ViewModels.StudentFormViewModel
@{
    ViewData["Title"] = "Add Student";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-person-plus-fill me-2"></i>Add Student</h3>
    <a asp-controller="Students" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        @using (Html.BeginForm("AddStudent", "Students", FormMethod.Post, new { id = "studentCreateForm" }))
        {
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("_Form", Model)
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/students.js"></script>
}
