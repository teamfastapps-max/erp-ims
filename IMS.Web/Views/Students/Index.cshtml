@model IMS.Models.ViewModels.StudentIndexViewModel
@{
    ViewData["Title"] = "Students";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-people-fill me-2"></i>Students</h3>
    <a asp-controller="Students" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Student
    </a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Index", "Students", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-3">
                @Html.Label("searchTerm", "Search", new { @class = "form-label" })
                @Html.TextBox("searchTerm", Model.SearchTerm, new { @class = "form-control", placeholder = "Name, admission no. or code" })
            </div>
            <div class="col-md-3">
                @Html.Label("status", "Status", new { @class = "form-label" })
                @Html.DropDownList("status", Model.StatusOptions, "All Statuses", new { @class = "form-select" })
            </div>
            <div class="col-md-2">
                @Html.Label("branchId", "Branch", new { @class = "form-label" })
                @Html.DropDownList("branchId", Model.BranchOptions, "All Branches", new { @class = "form-select" })
            </div>
            <div class="col-md-2">
                @Html.Label("classId", "Class", new { @class = "form-label" })
                @Html.DropDownList("classId", Model.ClassOptions, "All Classes", new { @class = "form-select" })
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-search me-1"></i> Filter
                </button>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Student Code</th>
                    <th>Admission No.</th>
                    <th>Name</th>
                    <th>Class / Section</th>
                    <th>Branch</th>
                    <th>Admission Date</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="studentsTableBody">
                @if (!Model.Students.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No students found.</td>
                    </tr>
                }
                else
                {
                    foreach (var s in Model.Students)
                    {
                        <tr id="student-row-@s.S_Id">
                            <td>@s.S_StudentCode</td>
                            <td>@s.S_AdmissionNumber</td>
                            <td>@s.FullName</td>
                            <td>@s.ClassName @(s.SectionName != "-" ? $"- {s.SectionName}" : "")</td>
                            <td>@s.BranchName</td>
                            <td>@(s.S_AdmissionDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                            <td><span class="badge @StatusBadgeClass(s.S_Status)">@s.S_Status</span></td>
                            <td class="text-end">
                                <a asp-controller="Students" asp-action="Details" asp-route-id="@s.S_Id"
                                   class="btn btn-sm btn-outline-secondary" title="View"><i class="bi bi-eye"></i></a>
                                <a asp-controller="Students" asp-action="Edit" asp-route-id="@s.S_Id"
                                   class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger confirm-delete-btn"
                                        data-id="@s.S_Id" data-bs-toggle="modal" data-bs-target="#deleteModal-@s.S_Id" title="Remove">
                                    <i class="bi bi-trash"></i>
                                </button>

                                <div class="modal fade" id="deleteModal-@s.S_Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Remove Student</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to remove <strong>@s.FullName</strong>?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="button" class="btn btn-danger do-delete-btn">Remove</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                       href="@Url.Action("Index", "Students", new { searchTerm = Model.SearchTerm, status = Model.StatusFilter, branchId = Model.BranchFilter, classId = Model.ClassFilter, page = p })">
                        @p
                    </a>
                </li>
            }
        </ul>
    </nav>
}

@functions {
    string StatusBadgeClass(string status) => status switch
    {
        "Active" => "bg-success",
        "Admitted" => "bg-info text-dark",
        "Inactive" => "bg-secondary",
        "Transferred" => "bg-warning text-dark",
        "Alumni" => "bg-primary",
        "Dropped" => "bg-danger",
        _ => "bg-light text-dark"
    };
}

@section Scripts {
    <script src="~/js/students.js"></script>
}
