@model IMS.Models.ViewModels.StudentFormViewModel

@Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

@if (Model.S_Id.HasValue)
{
    @Html.HiddenFor(m => m.S_Id)
}

<div class="row g-3">
    <div class="col-md-4">
        @Html.LabelFor(m => m.S_BranchId, new { @class = "form-label" })
        @Html.DropDownListFor(m => m.S_BranchId, Model.BranchOptions, "Select Branch", new { @class = "form-select" })
        @Html.ValidationMessageFor(m => m.S_BranchId, "", new { @class = "text-danger small" })
    </div>
    <div class="col-md-4">
        @Html.LabelFor(m => m.S_StudentCode, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.S_StudentCode, new { @class = "form-control", placeholder = "Auto-generated if left blank" })
        @Html.ValidationMessageFor(m => m.S_StudentCode, "", new { @class = "text-danger small" })
    </div>
    <div class="col-md-4">
        @Html.LabelFor(m => m.S_AdmissionNumber, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.S_AdmissionNumber, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.S_AdmissionNumber, "", new { @class = "text-danger small" })
    </div>
</div>

<hr class="my-4" />
<h6 class="text-muted mb-3">Personal Details</h6>

<div class="row g-3">
    <div class="col-md-4">
        @Html.LabelFor(m => m.S_FirstName, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.S_FirstName, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.S_FirstName, "", new { @class = "text-danger small" })
    </div>
    <div class="col-md-4">
        @Html.LabelFor(m => m.S_MiddleName, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.S_MiddleName, new { @class = "form-control" })
    </div>
    <div class="col-md-4">
        @Html.LabelFor(m => m.S_LastName, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.S_LastName, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.S_LastName, "", new { @class = "text-danger small" })
    </div>

    <div class="col-md-4">
        @Html.LabelFor(m => m.S_DateOfBirth, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.S_DateOfBirth, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
    </div>
    <div class="col-md-4">
        @Html.LabelFor(m => m.S_Gender, new { @class = "form-label" })
        @Html.DropDownListFor(m => m.S_Gender, Model.GenderOptions, "Select Gender", new { @class = "form-select" })
    </div>
    <div class="col-md-4">
        @Html.LabelFor(m => m.S_AdmissionDate, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.S_AdmissionDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
    </div>
</div>

<hr class="my-4" />
<h6 class="text-muted mb-3">Contact & Status</h6>

<div class="row g-3">
    <div class="col-md-4">
        @Html.LabelFor(m => m.S_Email, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.S_Email, new { @class = "form-control", type = "email" })
        @Html.ValidationMessageFor(m => m.S_Email, "", new { @class = "text-danger small" })
    </div>
    <div class="col-md-4">
        @Html.LabelFor(m => m.S_Phone, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.S_Phone, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.S_Phone, "", new { @class = "text-danger small" })
    </div>
    <div class="col-md-4">
        @Html.LabelFor(m => m.S_Status, new { @class = "form-label" })
        @Html.DropDownListFor(m => m.S_Status, Model.StatusOptions, new { @class = "form-select" })
        @Html.ValidationMessageFor(m => m.S_Status, "", new { @class = "text-danger small" })
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mt-4">
    <a asp-controller="Students" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i> Save Student
    </button>
</div>
