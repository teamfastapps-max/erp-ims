@model IMS.Models.ViewModels.StaffIndexViewModel
@{
    ViewData["Title"] = "Staff";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-chalkboard-user me-2"></i>Staff</h3>
    <a asp-controller="Staff" asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-plus me-1"></i> Add Staff
    </a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Index", "Staff", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-3">
                @Html.Label("searchTerm", "Search", new { @class = "form-label" })
                @Html.TextBox("searchTerm", Model.SearchTerm, new { @class = "form-control", placeholder = "Name, code or email" })
            </div>
            <div class="col-md-2">
                @Html.Label("branchId", "Branch", new { @class = "form-label" })
                @Html.DropDownList("branchId", Model.BranchOptions, "All Branches", new { @class = "form-select" })
            </div>
            <div class="col-md-2">
                @Html.Label("status", "Status", new { @class = "form-label" })
                @Html.DropDownList("status", Model.StatusOptions, "All Statuses", new { @class = "form-select" })
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="fa-solid fa-search me-1"></i> Filter
                </button>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive p-3">
        <table id="dataTable" class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Branch</th>
                    <th>Department</th>
                    <th>Designation</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.StaffList.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No staff members found.</td></tr>
                }
                else
                {
                    foreach (var s in Model.StaffList)
                    {
                        <tr id="staff-row-@s.ST_Id">
                            <td>@s.ST_EmployeeCode</td>
                            <td>@s.ST_FirstName @s.ST_LastName</td>
                            <td>@(s.ST_Email ?? "-")</td>
                            <td>@s.BranchName</td>
                            <td>@s.DepartmentName</td>
                            <td>@s.DesignationName</td>
                            <td><span class="badge @StatusBadgeClass(s.ST_Status)">@s.ST_Status</span></td>
                            <td class="text-end">
                                <a asp-controller="Staff" asp-action="Details" asp-route-id="@s.ST_Id"
                                   class="btn btn-sm btn-outline-secondary" title="View"><i class="fa-solid fa-eye"></i></a>
                                <a asp-controller="Staff" asp-action="Edit" asp-route-id="@s.ST_Id"
                                   class="btn btn-sm btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger confirm-delete-btn"
                                        data-id="@s.ST_Id" data-bs-toggle="modal" data-bs-target="#deleteModal-@s.ST_Id" title="Delete">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                                <div class="modal fade" id="deleteModal-@s.ST_Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Delete Staff</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">Are you sure you want to delete <strong>@s.ST_FirstName @s.ST_LastName</strong>?</div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="button" class="btn btn-danger do-delete-btn">Delete</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

@functions {
    string StatusBadgeClass(string status) => status switch
    {
        "Active" => "bg-success",
        "Inactive" => "bg-secondary",
        "On Leave" => "bg-warning text-dark",
        "Terminated" => "bg-danger",
        _ => "bg-light text-dark"
    };
}

@section Scripts {
    <script src="~/js/staff.js"></script>
    <script>$(function () { $('#dataTable').DataTable({ pageLength: 10, lengthMenu: [10, 25, 50, 100], order: [[1, 'asc']] }); });</script>
}
