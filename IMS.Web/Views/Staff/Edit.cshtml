@model IMS.Models.ViewModels.StaffFormViewModel
@{ ViewData["Title"] = "Edit Staff"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-chalkboard-user me-2"></i>Edit Staff</h3>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form id="staffEditForm" asp-controller="Staff" asp-action="EditStaff" method="post">
            @Html.AntiForgeryToken()
            <partial name="_Form" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/common/datepicker.js"></script>
    <script src="~/js/staff.js"></script>
    <script>
        $(function () {
            IMSStaffForm.init('/Staff/EditStaff');
            IMSDatePicker.init({ input: '#ST_JoiningDate', format: 'dd/MM/yyyy', valueFormat: 'yyyy-MM-dd', placeholder: 'DD/MM/YYYY' });
        });
    </script>
}
