@model IMS.Models.TenantUser.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-person-circle me-2"></i>My Profile</h3>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<style>
    #heroAvatarWrap:hover #heroAvatarHoverOverlay {
        background: rgba(0, 0, 0, 0.35) !important;
    }

        #heroAvatarWrap:hover #heroAvatarHoverOverlay i {
            opacity: 1 !important;
        }
</style>

<div class="card shadow-sm mb-3">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap align-items-center gap-3">
            <div>
                <div class="sd-avatar position-relative" id="heroAvatarWrap" style="overflow:hidden;padding:0;cursor:pointer;" title="Click to change your photo">
                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePic))
                    {
                        <img id="heroAvatarImg" src="@Model.ProfilePic" alt="Profile photo" style="width:100%;height:100%;object-fit:cover;" />
                    }
                    else
                    {
                        <i class="bi bi-person-fill"></i>
                    }
                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
                         style="background:rgba(0,0,0,0);transition:background .15s ease;" id="heroAvatarHoverOverlay">
                        <i class="bi bi-camera-fill text-white" style="font-size:1.1rem;opacity:0;transition:opacity .15s ease;"></i>
                    </div>
                </div>
                <input type="file" id="profilePicInput" accept="image/jpeg,image/png,image/gif,image/webp" class="d-none" />
                <div class="text-danger small text-center mt-1" id="profilePicError" style="max-width:88px;"></div>
            </div>
            <div class="flex-grow-1">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <h4 class="mb-0" id="profileDisplayName">@Model.FullName</h4>
                    @if (!string.IsNullOrWhiteSpace(Model.Status))
                    {
                        <span class="badge bg-success">@Model.Status</span>
                    }
                </div>
                <div class="text-muted small mb-2">@Model.Email</div>
                <div class="d-flex flex-wrap gap-2">
                    @if (!string.IsNullOrWhiteSpace(Model.RoleName))
                    {
                        <span class="sd-chip"><i class="bi bi-shield-check"></i>@Model.RoleName</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.TenantName))
                    {
                        <span class="sd-chip"><i class="bi bi-building"></i>@Model.TenantName</span>
                    }
                    @if (Model.CreatedAt.HasValue)
                    {
                        <span class="sd-chip"><i class="bi bi-calendar-check"></i>Joined @Model.CreatedAt.Value.ToString("dd MMM yyyy")</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form id="profileForm">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.ProfilePic)

            <h6 class="text-muted mb-3">Personal Details</h6>
            <div class="row g-3">
                <div class="col-md-4">
                    <label for="Email" class="form-label">Email</label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control bg-light text-muted", @readonly = "readonly", tabindex = "-1" })
                    <div class="form-text small">Email can't be changed here — contact an administrator.</div>
                </div>
                <div class="col-md-4">
                    <label for="FirstName" class="form-label">First Name</label>
                    @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
                    <div class="text-danger small field-error" data-for="FirstName"></div>
                </div>
                <div class="col-md-4">
                    <label for="LastName" class="form-label">Last Name</label>
                    @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
                    <div class="text-danger small field-error" data-for="LastName"></div>
                </div>
                <div class="col-md-4">
                    <label for="Phone" class="form-label">Phone</label>
                    @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
                    <div class="text-danger small field-error" data-for="Phone"></div>
                </div>
            </div>

            <hr class="my-4" />
            <h6 class="text-muted mb-3">Address</h6>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="AddressLine1" class="form-label">Address Line 1</label>
                    @Html.TextBoxFor(m => m.AddressLine1, new { @class = "form-control" })
                </div>
                <div class="col-md-6">
                    <label for="AddressLine2" class="form-label">Address Line 2</label>
                    @Html.TextBoxFor(m => m.AddressLine2, new { @class = "form-control" })
                </div>
                <div class="col-md-3">
                    <label for="City" class="form-label">City</label>
                    @Html.TextBoxFor(m => m.City, new { @class = "form-control" })
                </div>
                <div class="col-md-3">
                    <label for="State" class="form-label">State</label>
                    @Html.TextBoxFor(m => m.State, new { @class = "form-control" })
                </div>
                <div class="col-md-3">
                    <label for="PostalCode" class="form-label">Postal Code</label>
                    @Html.TextBoxFor(m => m.PostalCode, new { @class = "form-control" })
                </div>
                <div class="col-md-3">
                    <label for="Country" class="form-label">Country</label>
                    @Html.TextBoxFor(m => m.Country, new { @class = "form-control" })
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/profile.js"></script>
}
