@model IMS.Models.ViewModels.TeacherLeaveIndexViewModel
@{
    ViewData["Title"] = "Leave Requests";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-calendar-x me-2"></i>Leave Requests</h3>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Index", "TeacherLeave", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-3">
                <label class="form-label">Status</label>
                @Html.DropDownList("status", Model.StatusOptions, "All Statuses", new { @class = "form-select" })
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-primary">Filter</button>
            </div>
        }
    </div>
</div>

@Html.AntiForgeryToken()

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Teacher</th><th>Type</th><th>From</th><th>To</th><th>Days</th>
                    <th>Reason</th><th>Status</th><th>Applied</th><th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Requests.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">No leave requests found.</td></tr>
                }
                else
                {
                    foreach (var r in Model.Requests)
                    {
                        <tr>
                            <td>@r.TeacherName</td>
                            <td>@r.LeaveType</td>
                            <td>@r.FromDate.ToString("dd-MMM-yyyy")</td>
                            <td>@r.ToDate.ToString("dd-MMM-yyyy")</td>
                            <td>@r.TotalDays</td>
                            <td>@(r.Reason ?? "-")</td>
                            <td>
                                <span class="badge @(r.Status switch {
                                    "Approved" => "bg-success", "Rejected" => "bg-danger",
                                    "Cancelled" => "bg-secondary", _ => "bg-warning text-dark" })">@r.Status</span>
                                @if (r.Status == "Rejected" && !string.IsNullOrEmpty(r.RejectionReason))
                                {
                                    <div class="small text-muted mt-1">@r.RejectionReason</div>
                                }
                            </td>
                            <td>@r.AppliedAt.ToString("dd-MMM-yyyy")</td>
                            <td class="text-end">
                                @if (r.Status == "Pending")
                                {
                                    <button class="btn btn-sm btn-outline-success approve-leave-btn" data-id="@r.TL_Id">
                                        <i class="bi bi-check-lg"></i> Approve
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-@r.TL_Id">
                                        <i class="bi bi-x-lg"></i> Reject
                                    </button>

                                    <div class="modal fade" id="rejectModal-@r.TL_Id" tabindex="-1" data-leave-id="@r.TL_Id">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Reject Leave Request</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <label class="form-label">Reason for rejection</label>
                                                    <textarea class="form-control reject-reason-input" rows="3"></textarea>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="button" class="btn btn-danger do-reject-btn">Reject</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { status = Model.StatusFilter, page = p })">@p</a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <link rel="stylesheet" href="~/css/teacherHr.css" />
    <script src="~/js/teacherLeave.js"></script>
}
