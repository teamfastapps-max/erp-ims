@model IMS.Models.ViewModels.MyLeaveViewModel
@{
    ViewData["Title"] = "My Leave";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-calendar-heart me-2"></i>My Leave</h3>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white"><h6 class="mb-0">Apply for Leave</h6></div>
    <div class="card-body">
        @using (Html.BeginForm("ApplyAjax", "TeacherLeave", FormMethod.Post, new { id = "applyLeaveForm" }))
        {
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Leave Type</label>
                    @Html.DropDownList("LeaveType", Model.LeaveTypeOptions, "Select Type", new { @class = "form-select" })
                    <div class="text-danger small field-error" data-for="LeaveType"></div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">From Date</label>
                    <input type="date" name="FromDate" class="form-control" />
                    <div class="text-danger small field-error" data-for="FromDate"></div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">To Date</label>
                    <input type="date" name="ToDate" class="form-control" />
                    <div class="text-danger small field-error" data-for="ToDate"></div>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-send me-1"></i> Submit Request
                    </button>
                </div>
                <div class="col-12">
                    <label class="form-label">Reason (optional)</label>
                    <textarea name="Reason" class="form-control" rows="2"></textarea>
                </div>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white"><h6 class="mb-0">My Requests</h6></div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Type</th><th>From</th><th>To</th><th>Days</th><th>Status</th><th>Applied</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @if (!Model.MyRequests.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No leave requests yet.</td></tr>
                }
                else
                {
                    foreach (var r in Model.MyRequests)
                    {
                        <tr>
                            <td>@r.LeaveType</td>
                            <td>@r.FromDate.ToString("dd-MMM-yyyy")</td>
                            <td>@r.ToDate.ToString("dd-MMM-yyyy")</td>
                            <td>@r.TotalDays</td>
                            <td>
                                <span class="badge @(r.Status switch {
                                    "Approved" => "bg-success", "Rejected" => "bg-danger",
                                    "Cancelled" => "bg-secondary", _ => "bg-warning text-dark" })">@r.Status</span>
                                @if (r.Status == "Rejected" && !string.IsNullOrEmpty(r.RejectionReason))
                                {
                                    <div class="small text-muted mt-1">@r.RejectionReason</div>
                                }
                            </td>
                            <td>@r.AppliedAt.ToString("dd-MMM-yyyy")</td>
                            @* <td class="text-end">
                                @if (r.Status == "Pending")
                                {
                                    <button class="btn btn-sm btn-outline-secondary cancel-leave-btn" data-id="@r.TL_Id">Cancel</button>
                                }
                            </td> *@
                            <td class="text-end">
                                @if (r.Status == "Pending")
                                {
                                    <button class="btn btn-sm btn-outline-primary edit-leave-btn"
                                            data-id="@r.TL_Id" data-type="@r.LeaveType"
                                            data-from="@r.FromDate.ToString("yyyy-MM-dd")" data-to="@r.ToDate.ToString("yyyy-MM-dd")"
                                            data-reason="@r.Reason" data-bs-toggle="modal" data-bs-target="#editLeaveModal">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary cancel-leave-btn" data-id="@r.TL_Id">Cancel</button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<div class="modal fade" id="editLeaveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Leave Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" class="edit-leave-id" />
                <div class="mb-2">
                    <label class="form-label">Leave Type</label>
                    <select class="form-select edit-leave-type">
                        @foreach (var t in IMS.Helpers.Constants.TeacherHrOptions.LeaveTypes)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label">From</label>
                        <input type="date" class="form-control edit-leave-from" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">To</label>
                        <input type="date" class="form-control edit-leave-to" />
                    </div>
                </div>
                <label class="form-label">Reason</label>
                <textarea class="form-control edit-leave-reason" rows="2"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary do-edit-btn">Save Changes</button>
            </div>
        </div>
    </div>
</div>
@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="@Url.Action("MyLeave", new { page = p })">@p</a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <link rel="stylesheet" href="~/css/teacherHr.css" />
    <script src="~/js/teacherLeave.js"></script>
}
