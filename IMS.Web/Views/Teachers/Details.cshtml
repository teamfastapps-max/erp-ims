@model IMS.Models.Teacher.TeacherDetailsViewModel
@{
    ViewData["Title"] = "Teacher Details";

    string InitialsOf(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim().Substring(0, 1).ToUpper();

    string StatusBadgeClass(string status) => (status ?? "").ToLower() switch
    {
        "active" => "bg-success",
        "onleave" => "bg-warning text-dark",
        "resigned" or "terminated" => "bg-secondary",
        _ => "bg-info text-dark"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-person-badge-fill me-2"></i>Teacher Details</h3>
    <div class="d-flex gap-2">
        <a asp-controller="Teachers" asp-action="Edit" asp-route-id="@Model.T_Id" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-controller="Teachers" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap align-items-center gap-3">
            <div class="sd-avatar">@InitialsOf(Model.FullName)</div>
            <div class="flex-grow-1">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <h4 class="mb-0">@Model.FullName</h4>
                    <span class="badge @StatusBadgeClass(Model.T_Status)">@Model.T_Status</span>
                </div>
                <div class="text-muted small mb-2">
                    @Model.T_EmployeeCode @(string.IsNullOrWhiteSpace(Model.RoleName) ? "" : $"· {Model.RoleName}")
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <span class="sd-chip"><i class="bi bi-diagram-3"></i>@Model.BranchName</span>
                    @if (!string.IsNullOrWhiteSpace(Model.Designation))
                    {
                        <span class="sd-chip"><i class="bi bi-mortarboard"></i>@Model.Designation</span>
                    }
                    @if (Model.T_JoiningDate.HasValue)
                    {
                        <span class="sd-chip"><i class="bi bi-calendar-check"></i>Joined @Model.T_JoiningDate.Value.ToString("dd MMM yyyy")</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="sd-section-title">Contact</div>
                <div class="sd-field">
                    <div class="sd-field-icon"><i class="bi bi-envelope"></i></div>
                    <div>
                        <div class="sd-field-label">Email</div>
                        <div class="sd-field-value">
                            @if (!string.IsNullOrWhiteSpace(Model.Email))
                            {
                                <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                            }
                            else
                            {

                                <text>-</text>
                            }
                        </div>
                    </div>
                </div>
                <div class="sd-field">
                    <div class="sd-field-icon"><i class="bi bi-telephone"></i></div>
                    <div>
                        <div class="sd-field-label">Phone</div>
                        <div class="sd-field-value">
                            @if (!string.IsNullOrWhiteSpace(Model.Phone))
                            {
                                <a href="tel:@Model.Phone" class="text-decoration-none">@Model.Phone</a>
                            }
                            else
                            {

                                <text>-</text>
                            }
                        </div>
                    </div>
                </div>
                <div class="sd-field">
                    <div class="sd-field-icon"><i class="bi bi-geo-alt"></i></div>
                    <div>
                        <div class="sd-field-label">Address</div>
                        <div class="sd-field-value">@Model.FullAddress</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="sd-section-title">Professional</div>
                <div class="sd-field">
                    <div class="sd-field-icon"><i class="bi bi-mortarboard"></i></div>
                    <div>
                        <div class="sd-field-label">Qualification</div>
                        <div class="sd-field-value">@(Model.T_Qualification ?? "-")</div>
                    </div>
                </div>
                <div class="sd-field">
                    <div class="sd-field-icon"><i class="bi bi-briefcase"></i></div>
                    <div>
                        <div class="sd-field-label">Experience</div>
                        <div class="sd-field-value">@(Model.T_ExperienceYears.HasValue ? $"{Model.T_ExperienceYears} yrs" : "-")</div>
                    </div>
                </div>
                <div class="sd-field">
                    <div class="sd-field-icon"><i class="bi bi-droplet-half"></i></div>
                    <div>
                        <div class="sd-field-label">Blood Group</div>
                        <div class="sd-field-value">@(Model.T_BloodGroup ?? "-")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="sd-section-title">Employment</div>
                <div class="row">
                    <div class="col-sm-6 col-lg-3">
                        <div class="sd-field">
                            <div class="sd-field-icon"><i class="bi bi-diagram-3"></i></div>
                            <div>
                                <div class="sd-field-label">Branch</div>
                                <div class="sd-field-value">@Model.BranchName</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="sd-field">
                            <div class="sd-field-icon"><i class="bi bi-building"></i></div>
                            <div>
                                <div class="sd-field-label">Department</div>
                                <div class="sd-field-value">@(Model.Department ?? "-")</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="sd-field">
                            <div class="sd-field-icon"><i class="bi bi-shield-check"></i></div>
                            <div>
                                <div class="sd-field-label">Role</div>
                                <div class="sd-field-value">@(Model.RoleName ?? "-")</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="sd-field">
                            <div class="sd-field-icon"><i class="bi bi-calendar-check"></i></div>
                            <div>
                                <div class="sd-field-label">Joining Date</div>
                                <div class="sd-field-value">@(Model.T_JoiningDate?.ToString("dd MMM yyyy") ?? "-")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>