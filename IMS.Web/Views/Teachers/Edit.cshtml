@model IMS.Models.Teacher.TeacherFormViewModel
@{
    ViewData["Title"] = "Edit Teacher";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Teacher</h3>
    <a asp-controller="Teachers" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form id="teacherEditForm">
            @if (Model.IsPendingSetup)
            {
                <div class="alert alert-warning d-flex align-items-center mb-4">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    This teacher was added from the tenant management portal and hasn't been fully set up here yet. Fill in the details below and save to complete their profile.
                </div>
            }
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("_Form", Model)
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/teacher.js"></script>
}