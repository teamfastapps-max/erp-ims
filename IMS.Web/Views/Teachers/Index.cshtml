@model IMS.Models.Teacher.TeacherIndexViewModel
@{
    ViewData["Title"] = "Teachers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-person-video3 me-2"></i>Teachers</h3>
    <a asp-controller="Teachers" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Teacher
    </a>
</div>
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" asp-controller="Teachers" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Name, employee code, email or phone" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    @foreach (var opt in Model.StatusOptions)
                    {
                        <option value="@opt.Value" selected="@(opt.Value == Model.StatusFilter)">@opt.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Branch</label>
                <select name="branchId" class="form-select">
                    <option value="">All Branches</option>
                    @foreach (var opt in Model.BranchOptions)
                    {
                        <option value="@opt.Value" selected="@(opt.Value == Model.BranchFilter?.ToString())">@opt.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-search me-1"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Employee Code</th>
                    <th>Name</th>
                    <th>Branch</th>
                    <th>Designation</th>
                    <th>Department</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Teachers.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No teachers found.</td></tr>
                }
                else
                {
                    @foreach (var t in Model.Teachers)
                    {
                        <tr id="teacher-row-@t.T_Id">
                            <td>@(t.T_EmployeeCode ?? "-")</td>
                            <td>@t.FullName</td>
                            <td>@t.BranchName</td>
                            <td>@(t.Designation ?? "-")</td>
                            <td>@(t.Department ?? "-")</td>
                            <td>
                                @if (t.IsPendingSetup)
                                {
                                    <span class="badge bg-warning text-dark">Pending Setup</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@t.T_Status</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (t.IsPendingSetup)
                                {
                                    <a asp-controller="Teachers" asp-action="Edit" asp-route-id="@t.T_Id" class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-pencil-square me-1"></i>Complete Setup
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Teachers" asp-action="Details" asp-route-id="@t.T_Id" class="btn btn-sm btn-outline-secondary" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-controller="Teachers" asp-action="Edit" asp-route-id="@t.T_Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger confirm-delete-btn" data-id="@t.T_Id" data-bs-toggle="modal" data-bs-target="#deleteModal-@t.T_Id" title="Remove">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>

                        @if (!t.IsPendingSetup)
                        {
                            <div class="modal fade" id="deleteModal-@t.T_Id" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Remove Teacher</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            Remove <strong>@t.FullName</strong>? This also disables their login access.
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <button type="button" class="btn btn-danger do-delete-btn">Remove</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/teacher.js"></script>
}