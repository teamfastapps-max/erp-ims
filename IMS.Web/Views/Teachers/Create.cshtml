@model IMS.Models.Teacher.TeacherFormViewModel
@{
    ViewData["Title"] = "Add Teacher";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-person-plus-fill me-2"></i>Add Teacher</h3>
    <a asp-controller="Teachers" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form id="teacherCreateForm">
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("_Form", Model)
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/teacher.js"></script>
}