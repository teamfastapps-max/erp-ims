@model IMS.Models.ViewModels.ExpenseDetailsViewModel
@{ ViewData["Title"] = "Expense Details"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-receipt me-2"></i>Expense Details</h3>
    <div>
        <a asp-controller="Expense" asp-action="Edit" asp-route-id="@Model.EXP_Id" class="btn btn-outline-primary btn-sm">
            <i class="fa-solid fa-pen me-1"></i> Edit
        </a>
        <a asp-controller="Expense" asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label text-muted">Expense Number</label>
                <div class="fw-semibold">@Model.EXP_ExpenseNumber</div>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted">Date</label>
                <div class="fw-semibold">@Model.EXP_ExpenseDate.ToString("dd-MMM-yyyy")</div>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted">Category</label>
                <div class="fw-semibold">@Model.ExpenseCategoryName</div>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted">Branch</label>
                <div class="fw-semibold">@Model.BranchName</div>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted">Vendor</label>
                <div class="fw-semibold">@(Model.VendorName ?? "-")</div>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted">Amount</label>
                <div class="fw-semibold">@Model.EXP_Amount.ToString("N2")</div>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted">Payment Method</label>
                <div class="fw-semibold">@(Model.PaymentMethodName ?? "-")</div>
            </div>
            <div class="col-md-12">
                <label class="form-label text-muted">Description</label>
                <div class="fw-semibold">@(Model.EXP_Description ?? "-")</div>
            </div>
        </div>
        <hr />
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label text-muted">Created At</label>
                <div>@Model.EXP_CreatedAt.ToString("dd-MMM-yyyy HH:mm")</div>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted">Last Updated</label>
                <div>@Model.EXP_UpdatedAt.ToString("dd-MMM-yyyy HH:mm")</div>
            </div>
        </div>
    </div>
</div>
