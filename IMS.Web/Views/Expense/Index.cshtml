@model IMS.Models.ViewModels.ExpenseIndexViewModel
@{
    ViewData["Title"] = "Expenses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="fa-solid fa-receipt me-2"></i>Expenses</h3>
    <a asp-controller="Expense" asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-plus me-1"></i> Add Expense
    </a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Index", "Expense", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-3">
                @Html.Label("searchTerm", "Search", new { @class = "form-label" })
                @Html.TextBox("searchTerm", Model.SearchTerm, new { @class = "form-control", placeholder = "Number or description" })
            </div>
            <div class="col-md-2">
                @Html.Label("branchId", "Branch", new { @class = "form-label" })
                @Html.DropDownList("branchId", Model.BranchOptions, "All Branches", new { @class = "form-select" })
            </div>
            <div class="col-md-2">
                @Html.Label("expenseCategoryId", "Category", new { @class = "form-label" })
                @Html.DropDownList("expenseCategoryId", Model.ExpenseCategoryOptions, "All Categories", new { @class = "form-select" })
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="fa-solid fa-search me-1"></i> Filter
                </button>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive p-3">
        <table id="dataTable" class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Number</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Branch</th>
                    <th>Vendor</th>
                    <th>Amount</th>
                    <th>Payment</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Expenses.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No expenses found.</td></tr>
                }
                else
                {
                    foreach (var e in Model.Expenses)
                    {
                        <tr id="expense-row-@e.EXP_Id">
                            <td>@e.EXP_ExpenseNumber</td>
                            <td>@e.EXP_ExpenseDate.ToString("dd-MMM-yyyy")</td>
                            <td>@e.ExpenseCategoryName</td>
                            <td>@e.BranchName</td>
                            <td>@e.VendorName</td>
                            <td>@e.EXP_Amount.ToString("N2")</td>
                            <td>@e.PaymentMethodName</td>
                            <td class="text-end">
                                <a asp-controller="Expense" asp-action="Details" asp-route-id="@e.EXP_Id"
                                   class="btn btn-sm btn-outline-secondary" title="View"><i class="fa-solid fa-eye"></i></a>
                                <a asp-controller="Expense" asp-action="Edit" asp-route-id="@e.EXP_Id"
                                   class="btn btn-sm btn-outline-primary" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger confirm-delete-btn"
                                        data-id="@e.EXP_Id" data-bs-toggle="modal" data-bs-target="#deleteModal-@e.EXP_Id" title="Delete">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                                <div class="modal fade" id="deleteModal-@e.EXP_Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Delete Expense</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">Are you sure you want to delete <strong>@e.EXP_ExpenseNumber</strong>?</div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="button" class="btn btn-danger do-delete-btn">Delete</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/expenses.js"></script>
    <script>$(function () { $('#dataTable').DataTable({ pageLength: 10, lengthMenu: [10, 25, 50, 100], order: [[0, 'desc']] }); });</script>
}
