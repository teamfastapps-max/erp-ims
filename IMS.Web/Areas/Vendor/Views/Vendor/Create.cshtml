@model IMS.Models.VendorModel

@{
    ViewData["Title"] = "Create Vendor";
}
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">

            <h4 class="mb-0">Create Vendor</h4>

        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="VendorName" class="form-label fw-bold"></label>
                        <input asp-for="VendorName" class="form-control" placeholder="Enter Vendor Name" />
                        <span asp-validation-for="VendorName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ContactPerson" class="form-label fw-bold"></label>
                        <input asp-for="ContactPerson" class="form-control" placeholder="Enter Contact Person" />
                        <span asp-validation-for="ContactPerson" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" class="form-control" placeholder="Enter Email Address" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="MobileNo" class="form-label fw-bold"></label>
                        <input asp-for="MobileNo" class="form-control" placeholder="Enter Mobile Number" />
                        <span asp-validation-for="MobileNo" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="GSTNo" class="form-label fw-bold"></label>
                        <input asp-for="GSTNo" class="form-control" placeholder="Enter GST Number" />
                        <span asp-validation-for="GSTNo" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="PANNo" class="form-label fw-bold"></label>
                        <input asp-for="PANNo" class="form-control" placeholder="Enter PAN Number" />
                        <span asp-validation-for="PANNo" class="text-danger"></span>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="Address" class="form-label fw-bold"></label>
                        <textarea asp-for="Address" rows="3" class="form-control" placeholder="Enter Address"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="City" class="form-label fw-bold"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="State" class="form-label fw-bold"></label>
                        <input asp-for="State" class="form-control" />
                        <span asp-validation-for="State" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="Country" class="form-label fw-bold"></label>
                        <input asp-for="Country" class="form-control" />
                        <span asp-validation-for="Country" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="PinCode" class="form-label fw-bold"></label>
                        <input asp-for="PinCode" class="form-control" />
                        <span asp-validation-for="PinCode" class="text-danger"></span>
                    </div>

                </div>

                <hr />

                <div class="text-end">

                    <button type="submit" class="btn btn-success">
                        <i class="fa fa-save"></i> Save
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fa fa-times"></i> Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}