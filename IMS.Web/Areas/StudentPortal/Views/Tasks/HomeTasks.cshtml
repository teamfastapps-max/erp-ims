@model IMS.Models.Portal.PortalHomeTaskViewModel
@{
    ViewData["Title"] = "Home Tasks & Assignments";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="fa-solid fa-list-check text-primary me-2"></i>Home Tasks &amp; Assignments</h4>
        <p class="text-muted small mb-0">Track daily homework, due dates, teacher guidelines, and submit online</p>
    </div>
</div>

@if (Model.Tasks.Count == 0)
{
    <div class="portal-card text-center py-5">
        <i class="fa-solid fa-clipboard-check fs-1 text-success mb-2"></i>
        <h5 class="fw-bold text-dark">No Homework Assigned</h5>
        <p class="text-muted mb-0">You're all clear! No active assignments found for your batch.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var task in Model.Tasks)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="portal-card h-100 d-flex flex-column">
                    <div class="portal-card-header bg-light">
                        <span class="badge bg-primary-subtle text-primary">@task.SubjectName</span>
                        <small class="@(task.IsOverdue && !task.IsSubmitted ? "text-danger fw-bold" : "text-muted")">
                            <i class="fa-regular fa-clock me-1"></i>Due: @task.DueDate.ToString("dd MMM yyyy")
                        </small>
                    </div>

                    <div class="portal-card-body flex-grow-1">
                        <h6 class="fw-bold text-dark mb-2">@task.Title</h6>
                        <p class="text-muted small mb-3" style="white-space: pre-line;">@task.Description</p>

                        @if (!string.IsNullOrEmpty(task.TeacherAttachmentUrl))
                        {
                            <div class="mb-3">
                                <a href="@task.TeacherAttachmentUrl" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill">
                                    <i class="fa-solid fa-paperclip me-1"></i>Teacher Attachment
                                </a>
                            </div>
                        }

                        <!-- Submission Status Banner -->
                        <div class="p-2 rounded-3 @(task.IsSubmitted ? "bg-success-subtle border border-success-subtle" : (task.IsOverdue ? "bg-danger-subtle border border-danger-subtle" : "bg-light border"))">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="small fw-semibold @(task.IsSubmitted ? "text-success" : (task.IsOverdue ? "text-danger" : "text-dark"))">
                                    Status: @(task.IsSubmitted ? "Submitted" : (task.IsOverdue ? "Overdue" : "Pending"))
                                </span>
                                @if (task.MarksObtained.HasValue && task.MaxMarks.HasValue)
                                {
                                    <span class="badge bg-success">@task.MarksObtained.Value.ToString("N0") / @task.MaxMarks.Value.ToString("N0")</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(task.TeacherRemarks))
                            {
                                <div class="text-muted small mt-1" style="font-size: 0.75rem;">
                                    <strong>Remarks:</strong> @task.TeacherRemarks
                                </div>
                            }
                        </div>
                    </div>

                    <div class="p-3 border-top bg-light">
                        @if (task.IsSubmitted)
                        {
                            <button class="btn btn-sm btn-outline-success w-100 rounded-pill" onclick="openHomeworkModal('@task.TaskId', '@task.Title', '@(task.MaxMarks?.ToString("N0") ?? "")')">
                                <i class="fa-solid fa-check me-1"></i>Update Submission
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-primary w-100 rounded-pill" onclick="openHomeworkModal('@task.TaskId', '@task.Title', '@(task.MaxMarks?.ToString("N0") ?? "")')">
                                <i class="fa-solid fa-arrow-up-from-bracket me-1"></i>Submit Homework
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Homework Submission Modal -->
<div class="modal fade" id="homeworkSubmitModal" tabindex="-1" aria-labelledby="homeworkSubmitModalLabel" aria-hidden="true" data-submit-url="@Url.Action("SubmitHomeTask", "Tasks", new { area = "StudentPortal" })">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom">
                <div>
                    <h5 class="modal-title fw-bold" id="homeworkSubmitModalLabel">
                        <i class="fa-solid fa-cloud-arrow-up text-primary me-2"></i>Submit Task
                    </h5>
                    <div id="hwTaskTitle" class="text-muted small fw-semibold"></div>
                    <span id="hwMaxMarks" class="badge bg-primary-subtle text-primary"></span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                @Html.AntiForgeryToken()
                <input type="hidden" id="hwTaskId" />

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Submission Notes / Answer Summary</label>
                    <textarea id="hwContent" class="form-control rounded-3" rows="4" placeholder="Type your answers, summary, or assignment notes here..."></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Attachment Link / Drive URL (Optional)</label>
                    <input type="url" id="hwAttachmentUrl" class="form-control rounded-3" placeholder="https://drive.google.com/..." />
                    <small class="text-muted">Paste your Google Drive, OneDrive, or document link</small>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnSubmitHw" class="btn btn-primary rounded-pill px-4" onclick="submitHomeworkAjax()">Submit Task</button>
            </div>
        </div>
    </div>
</div>
