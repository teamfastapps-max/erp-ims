@model IMS.Models.Portal.GuardianIdCardViewModel
@{
    ViewData["Title"] = "Guardian Identity Card";
}

<div class="d-flex align-items-center justify-content-between mb-4 no-print">
    <div>
        <h4 class="fw-bold mb-1"><i class="fa-solid fa-id-card-clip text-primary me-2"></i>Guardian Identity Card</h4>
        <p class="text-muted small mb-0">Official authorization pass for student pickup and parent-teacher communication</p>
    </div>
    <button onclick="window.print()" class="btn btn-primary rounded-pill">
        <i class="fa-solid fa-print me-2"></i>Print Guardian Card
    </button>
</div>

<!-- Digital Guardian ID Card -->
<div class="id-card-container">
    <div class="id-card-header" style="background: linear-gradient(135deg, #4f46e5, #7c3aed);">
        <div class="fw-bold fs-5 text-uppercase letter-spacing-1">@(Model.OrganizationName ?? "INSTITUTE OF EDUCATION")</div>
        <div class="small opacity-75">Authorized Parent / Guardian Pass</div>
        <div class="mt-2 text-center">
            <span class="badge bg-light text-dark fw-bold px-3 py-1 text-uppercase">Guardian Gate Pass</span>
        </div>
    </div>

    <div class="id-card-body">
        <div class="id-card-photo" style="border-color: #ede9fe; color: #7c3aed;">
            <i class="fa-solid fa-user-tie"></i>
        </div>

        <h5 class="fw-bold text-dark mb-1">@Model.GuardianName</h5>
        <div class="text-muted small mb-3">Phone: <strong>@Model.Phone</strong></div>

        <div class="text-start mb-2">
            <div class="fw-bold small text-muted text-uppercase mb-1">Authorized Wards (Children):</div>
            <ul class="list-group list-group-flush border rounded-3 p-2 bg-light">
                @foreach (var ward in Model.Wards)
                {
                    <li class="list-group-item bg-transparent px-0 py-1 border-0 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-bold text-dark">@ward.StudentName</span>
                            <div class="text-muted" style="font-size: 0.72rem;">Adm: @ward.AdmissionNumber • @(ward.BatchName ?? "General")</div>
                        </div>
                        <span class="badge bg-primary-subtle text-primary">Student</span>
                    </li>
                }
            </ul>
        </div>

        <div class="p-2 border rounded-3 bg-light d-inline-block text-center mt-2">
            <i class="fa-solid fa-qrcode fs-1 text-dark"></i>
            <div class="text-muted" style="font-size: 0.65rem;">@Model.Phone</div>
        </div>
    </div>

    <div class="id-card-footer">
        <div>Please present this pass for student pickup from campus or bus stops.</div>
    </div>
</div>
