@model IMS.Models.Portal.GuardianIdCardViewModel
@{
    ViewData["Title"] = "Guardian Identity Card";
}

<div class="d-flex align-items-center justify-content-between mb-4 no-print">
    <div>
        <h4 class="fw-bold mb-1"><i class="fa-solid fa-id-card-clip text-primary me-2"></i>Guardian Identity Card</h4>
        <p class="text-muted small mb-0">Official authorization pass for student pickup and parent-teacher communication</p>
    </div>
    <button onclick="window.print()" class="btn btn-primary rounded-pill px-4 shadow-sm">
        <i class="fa-solid fa-print me-2"></i>Print Guardian Card
    </button>
</div>

<!-- Digital Guardian ID Card -->
<div class="id-card-wrapper">
    <div class="id-card-container">
        <div class="id-card-header guardian-header">
            <div class="id-card-lanyard-hole"></div>
            <div class="fw-bold fs-5 text-uppercase letter-spacing-1 mt-2">@(Model.OrganizationName ?? "INSTITUTE OF EDUCATION")</div>
            <div class="small opacity-90 fw-medium">Authorized Parent / Guardian Gate Pass</div>
            <div class="mt-2 text-center">
                <span class="badge bg-white text-dark fw-bold px-3 py-1 text-uppercase shadow-sm" style="font-size: 0.7rem; letter-spacing: 0.5px;">GUARDIAN GATE PASS</span>
            </div>
        </div>

        <div class="id-card-body">
            <div class="id-card-photo-wrapper">
                <div class="id-card-photo guardian-photo">
                    <i class="fa-solid fa-user-tie"></i>
                </div>
            </div>

            <h5 class="fw-bold text-dark mb-1">@(string.IsNullOrWhiteSpace(Model.GuardianName) ? "Authorized Guardian" : Model.GuardianName)</h5>
            <div class="text-muted small mb-3">
                <i class="fa-solid fa-phone text-primary me-1"></i> Phone: <strong>@(string.IsNullOrWhiteSpace(Model.Phone) ? "+91-XXXXXXXXXX" : Model.Phone)</strong>
            </div>

            <div class="text-start mb-2">
                <div class="fw-bold small text-muted text-uppercase mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                    <i class="fa-solid fa-children text-primary me-1"></i> Authorized Wards (Children):
                </div>
                <div class="border rounded-3 p-2 bg-light">
                    @if (Model.Wards != null && Model.Wards.Any())
                    {
                        @foreach (var ward in Model.Wards)
                        {
                            <div class="d-flex justify-content-between align-items-center py-1 border-bottom border-light-subtle last-border-0">
                                <div>
                                    <div class="fw-bold text-dark" style="font-size: 0.85rem;">@ward.StudentName</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">Adm: @(ward.AdmissionNumber ?? "ADM-001") • @(ward.BatchName ?? "General Batch")</div>
                                </div>
                                <span class="badge bg-primary-subtle text-primary" style="font-size: 0.68rem;">Student</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small py-1 text-center">Primary Linked Student</div>
                    }
                </div>
            </div>

            <!-- QR Verification Code -->
            <div class="p-2 border rounded-3 bg-light d-inline-block text-center mt-2">
                <i class="fa-solid fa-qrcode fs-2 text-dark"></i>
                <div class="text-muted fw-mono" style="font-size: 0.65rem;">@(Model.Phone ?? "VERIFIED-PASS")</div>
            </div>
        </div>

        <div class="id-card-footer">
            <div>Please present this pass for student pickup from campus or school bus.</div>
            <div class="fw-semibold text-dark mt-1">Campus Security Helpline: 9000000001</div>
        </div>
    </div>
</div>
