@model IMS.Models.Portal.PortalTimetableViewModel
@{
    ViewData["Title"] = "Class Timetable";
    var days = new[] {
        new { Id = 2, Name = "Monday" },
        new { Id = 3, Name = "Tuesday" },
        new { Id = 4, Name = "Wednesday" },
        new { Id = 5, Name = "Thursday" },
        new { Id = 6, Name = "Friday" },
        new { Id = 7, Name = "Saturday" },
        new { Id = 1, Name = "Sunday" }
    };
    int currentDayOfWeek = (int)DateTime.Now.DayOfWeek;
    // System.DayOfWeek: 0 = Sunday, 1 = Monday ... map to SQL: 1=Sun, 2=Mon
    int sqlToday = currentDayOfWeek == 0 ? 1 : currentDayOfWeek + 1;
}

<div class="d-flex align-items-center justify-content-between mb-4 no-print">
    <div>
        <h4 class="fw-bold mb-1"><i class="fa-solid fa-calendar-week text-primary me-2"></i>Weekly Class Timetable</h4>
        <p class="text-muted small mb-0">Period-by-period schedule for your enrolled batch</p>
    </div>
    <button onclick="window.print()" class="btn btn-outline-primary rounded-pill btn-sm">
        <i class="fa-solid fa-print me-1"></i>Print Timetable
    </button>
</div>

<!-- Timetable Day Tabs -->
<ul class="nav nav-pills mb-3 gap-2 no-print" id="timetableTabs" role="tablist">
    @foreach (var d in days)
    {
        var isToday = d.Id == sqlToday;
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-3 py-2 fw-semibold @(isToday ? "active" : "")"
                    id="tab-@d.Id"
                    data-bs-toggle="pill"
                    data-bs-target="#content-@d.Id"
                    type="button"
                    role="tab">
                @d.Name
                @if (isToday)
                {
                    <span class="badge bg-white text-primary ms-1">Today</span>
                }
            </button>
        </li>
    }
</ul>

<div class="tab-content" id="timetableTabContent">
    @foreach (var d in days)
    {
        var isToday = d.Id == sqlToday;
        var daySlots = Model.Slots.Where(s => s.DayOfWeek == d.Id).OrderBy(s => s.StartTime).ToList();

        <div class="tab-pane fade @(isToday ? "show active" : "")" id="content-@d.Id" role="tabpanel">
            <div class="portal-card">
                <div class="portal-card-header">
                    <h5 class="portal-card-title">
                        <i class="fa-regular fa-clock text-primary"></i>@d.Name Schedule
                    </h5>
                    <span class="badge bg-primary-subtle text-primary">@daySlots.Count Periods</span>
                </div>
                <div class="portal-card-body">
                    @if (daySlots.Count == 0)
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fa-solid fa-mug-hot fs-2 mb-2 text-secondary"></i>
                            <p class="mb-0 fw-semibold">No classes scheduled on @d.Name</p>
                            <small>Enjoy your self-study time or extracurricular activities.</small>
                        </div>
                    }
                    else
                    {
                        <div class="schedule-list">
                            @foreach (var slot in daySlots)
                            {
                                <div class="schedule-item">
                                    <div class="schedule-time">
                                        <div class="fw-bold">@slot.StartTime.ToString(@"hh\:mm")</div>
                                        <small class="text-muted">to @slot.EndTime.ToString(@"hh\:mm")</small>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="schedule-subject">
                                            @slot.SubjectName
                                            @if (!string.IsNullOrEmpty(slot.SubjectCode))
                                            {
                                                <span class="badge bg-light text-muted border ms-1">@slot.SubjectCode</span>
                                            }
                                        </div>
                                        <div class="schedule-teacher">
                                            <i class="fa-regular fa-user me-1"></i>@(slot.TeacherName ?? "Assigned Faculty")
                                            @if (!string.IsNullOrEmpty(slot.ClassroomName))
                                            {
                                                <span class="ms-2 badge bg-light text-dark border">
                                                    <i class="fa-solid fa-door-open me-1"></i>Room: @slot.ClassroomName
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
