@model IMS.Models.Portal.PortalAttendanceViewModel
@{
    ViewData["Title"] = "Attendance Tracker";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1"><i class="fa-solid fa-calendar-check text-primary me-2"></i>Attendance Tracker</h4>
        <p class="text-muted small mb-0">Daily session log and monthly attendance percentage</p>
    </div>

    <!-- Month & Year Selector Form -->
    <form method="get" asp-area="StudentPortal" asp-controller="Academics" asp-action="Attendance" class="d-flex align-items-center gap-2">
        <select name="month" class="form-select form-select-sm rounded-pill">
            @for (int m = 1; m <= 12; m++)
            {
                var mName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m);
                if (m == Model.Month)
                {
                    <option value="@m" selected>@mName</option>
                }
                else
                {
                    <option value="@m">@mName</option>
                }
            }
        </select>
        <select name="year" class="form-select form-select-sm rounded-pill">
            @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 2; y--)
            {
                if (y == Model.Year)
                {
                    <option value="@y" selected>@y</option>
                }
                else
                {
                    <option value="@y">@y</option>
                }
            }
        </select>
        <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">Filter</button>
    </form>
</div>

<!-- Attendance Stat Counters -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-icon-box stat-icon-blue">
                <i class="fa-solid fa-percent"></i>
            </div>
            <div class="stat-meta">
                <div class="stat-value">@Model.Percentage%</div>
                <div class="stat-label">Monthly Rate</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-icon-box stat-icon-green">
                <i class="fa-solid fa-check"></i>
            </div>
            <div class="stat-meta">
                <div class="stat-value">@Model.PresentCount</div>
                <div class="stat-label">Present Days</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-icon-box stat-icon-amber">
                <i class="fa-solid fa-clock-half-to-four"></i>
            </div>
            <div class="stat-meta">
                <div class="stat-value">@Model.HalfDayCount</div>
                <div class="stat-label">Half Days</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-icon-box" style="background: #fee2e2; color: #ef4444;">
                <i class="fa-solid fa-xmark"></i>
            </div>
            <div class="stat-meta">
                <div class="stat-value">@Model.AbsentCount</div>
                <div class="stat-label">Absences</div>
            </div>
        </div>
    </div>
</div>

<!-- Attendance Daily Log Table -->
<div class="portal-card">
    <div class="portal-card-header">
        <h5 class="portal-card-title">
            <i class="fa-regular fa-calendar text-primary"></i>Daily Records for @Model.MonthName @Model.Year
        </h5>
        <span class="badge bg-secondary-subtle text-dark">Total: @Model.TotalDaysInMonth sessions</span>
    </div>
    <div class="portal-card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Date</th>
                        <th>Day</th>
                        <th>Status</th>
                        <th>Session Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Records.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                No attendance entries recorded for this month.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var day in Model.Records)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">@day.AttendanceDate.ToString("dd MMM yyyy")</td>
                                <td class="text-muted small">@day.AttendanceDate.ToString("dddd")</td>
                                <td>
                                    @if (day.Status == "Present")
                                    {
                                        <span class="badge bg-success-subtle text-success fw-bold px-2 py-1">
                                            <i class="fa-solid fa-circle-check me-1"></i>Present
                                        </span>
                                    }
                                    else if (day.Status == "Absent")
                                    {
                                        <span class="badge bg-danger-subtle text-danger fw-bold px-2 py-1">
                                            <i class="fa-solid fa-circle-xmark me-1"></i>Absent
                                        </span>
                                    }
                                    else if (day.Status == "HalfDay")
                                    {
                                        <span class="badge bg-warning-subtle text-warning fw-bold px-2 py-1">
                                            <i class="fa-solid fa-clock me-1"></i>Half Day
                                        </span>
                                    }
                                    else if (day.Status == "Holiday" || day.Status == "Weekend")
                                    {
                                        <span class="badge bg-light text-secondary border px-2 py-1">
                                            @day.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary px-2 py-1">
                                            @(day.Status ?? "Unmarked")
                                        </span>
                                    }
                                </td>
                                <td class="text-muted small">@(day.Remarks ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
