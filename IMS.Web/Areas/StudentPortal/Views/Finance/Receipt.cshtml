@model IMS.Models.Portal.PortalReceiptViewModel
@{
    ViewData["Title"] = "Fee Payment Receipt";
}

<div class="d-flex align-items-center justify-content-between mb-4 no-print">
    <div>
        <h4 class="fw-bold mb-1"><i class="fa-solid fa-receipt text-primary me-2"></i>Fee Payment Receipt</h4>
        <p class="text-muted small mb-0">Official institutional acknowledgment for completed fee payment</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="StudentPortal" asp-controller="Finance" asp-action="Transactions" class="btn btn-outline-secondary rounded-pill">
            <i class="fa-solid fa-arrow-left me-1"></i>Back to Transactions
        </a>
        <button onclick="window.print()" class="btn btn-primary rounded-pill">
            <i class="fa-solid fa-print me-2"></i>Print Receipt
        </button>
    </div>
</div>

<div class="portal-card print-voucher mx-auto" style="max-width: 750px;">
    <div class="portal-card-body p-4">
        <!-- Institution Header -->
        <div class="text-center border-bottom pb-3 mb-3">
            <h4 class="fw-bold text-uppercase mb-1">@(Model.OrganizationName ?? "INSTITUTE OF EDUCATION")</h4>
            <div class="text-muted small">@(Model.BranchName ?? "Main Campus") • @(Model.BranchAddress ?? "")</div>
            <div class="text-muted small">Phone: @(Model.BranchPhone ?? "+91-XXXXXXXXXX")</div>
            <div class="badge bg-success-subtle text-success fs-6 px-3 py-1 mt-2 text-uppercase">
                Official Fee Payment Receipt
            </div>
        </div>

        <!-- Receipt & Student Info Details -->
        <div class="row g-2 mb-3 small">
            <div class="col-6">
                <div><strong>Receipt No:</strong> <span class="text-primary fw-bold">@Model.ReceiptNumber</span></div>
                <div><strong>Date &amp; Time:</strong> @Model.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                <div><strong>Payment Mode:</strong> @(Model.PaymentMode ?? "Direct Transfer")</div>
                @if (!string.IsNullOrEmpty(Model.TransactionRef))
                {
                    <div><strong>Txn Reference:</strong> @Model.TransactionRef</div>
                }
            </div>
            <div class="col-6 text-end">
                <div><strong>Student Name:</strong> <span class="fw-bold text-dark">@Model.StudentName</span></div>
                <div><strong>Admission / Roll:</strong> @(Model.AdmissionNumber ?? Model.StudentCode ?? "N/A")</div>
                <div><strong>Course:</strong> @(Model.CourseName ?? "General")</div>
                <div><strong>Batch:</strong> @(Model.BatchName ?? "Active")</div>
            </div>
        </div>

        <!-- Fee Items Allocated -->
        <div class="mb-4">
            <table class="table table-bordered table-sm align-middle mb-0 text-center small">
                <thead class="table-light">
                    <tr>
                        <th class="text-start ps-3">#</th>
                        <th>Settled Invoice Number</th>
                        <th class="text-end pe-3">Allocated Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.AllocatedInvoices.Count == 0)
                    {
                        <tr>
                            <td class="text-start ps-3">1</td>
                            <td>Payment Ref #@(Model.TransactionRef ?? Model.PaymentId.ToString().Substring(0, 8))</td>
                            <td class="text-end pe-3 fw-bold">₹@Model.PaidAmount.ToString("N0")</td>
                        </tr>
                    }
                    else
                    {
                        int invIndex = 1;
                        @foreach (var inv in Model.AllocatedInvoices)
                        {
                            <tr>
                                <td class="text-start ps-3">@(invIndex++)</td>
                                <td>@inv.InvoiceNumber</td>
                                <td class="text-end pe-3 fw-semibold">₹@inv.AmountPaid.ToString("N0")</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr class="table-light">
                        <td colspan="2" class="text-end fw-bold ps-3">Total Amount Paid:</td>
                        <td class="text-end pe-3 fw-bold fs-6 text-success">₹@Model.PaidAmount.ToString("N0")</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Digital Confirmation & Signatures -->
        <div class="row pt-4 text-center small">
            <div class="col-6">
                <div class="border-top pt-2 text-muted fw-semibold">Parent / Student Signature</div>
            </div>
            <div class="col-6">
                <div class="border-top pt-2 text-muted fw-semibold">Authorized Accounts Officer</div>
            </div>
        </div>

        <div class="text-center text-muted mt-3" style="font-size: 0.72rem;">
            This is an electronically generated official receipt issued by the ERP-IMS Student Portal.
        </div>
    </div>
</div>
