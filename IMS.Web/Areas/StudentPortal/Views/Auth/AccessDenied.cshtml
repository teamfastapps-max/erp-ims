@{
    ViewData["Title"] = "Access Denied - Student Portal";
    Layout = "~/Areas/StudentPortal/Views/Shared/_StudentPortalLayout.cshtml";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm p-5 mx-auto" style="max-width: 500px;">
        <i class="fa-solid fa-lock text-danger display-3 mb-3"></i>
        <h3 class="fw-bold text-dark mb-2">Access Denied</h3>
        <p class="text-muted">You do not have permission to access the requested resource or page.</p>
        <div class="mt-3">
            <a asp-area="StudentPortal" asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4">
                <i class="fa-solid fa-house me-1"></i>Return to Dashboard
            </a>
        </div>
    </div>
</div>
