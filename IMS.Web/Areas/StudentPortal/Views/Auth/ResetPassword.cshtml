@model IMS.Models.Portal.ResetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Reset Password - Student & Guardian Portal";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ERP-IMS</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Portal Design System -->
    <link rel="stylesheet" href="~/css/studentPortal.css" asp-append-version="true" />
</head>
<body class="login-page">

    <div class="login-wrapper">
        <div class="login-card shadow-lg">

            <!-- Card Header -->
            <div class="login-header">
                <div class="login-brand-icon">
                    <i class="bi bi-unlock-fill"></i>
                </div>
                <h4 class="fw-bold mb-1">Set New Password</h4>
                <p class="text-muted small mb-0">Create a secure password for your portal account</p>
            </div>

            <!-- Form Body -->
            <div class="login-body">
                @if (Model.IsSuccess)
                {
                    <div class="alert alert-success border-0 shadow-sm mb-4 text-center rounded-3 p-4">
                        <i class="bi bi-check-circle-fill fs-1 text-success d-block mb-2"></i>
                        <h5 class="fw-bold mb-1">Password Changed Successfully!</h5>
                        <p class="small text-muted mb-0">@Model.Message</p>
                    </div>

                    <a asp-area="StudentPortal" asp-controller="Auth" asp-action="Login" class="btn-portal-submit">
                        <span>Sign In with New Password</span>
                        <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                }
                else
                {
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 px-3 small border-0 shadow-sm mb-3 d-flex align-items-center gap-2 rounded-3">
                            <i class="bi bi-exclamation-octagon-fill text-danger fs-5"></i>
                            @Html.ValidationSummary(true, "", new { @class = "text-danger d-inline ps-0 mb-0" })
                        </div>
                    }

                    <form asp-area="StudentPortal" asp-controller="Auth" asp-action="ResetPassword" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Token" />

                        <div class="portal-form-group mb-3">
                            <label asp-for="NewPassword" class="portal-form-label">
                                <span>New Password</span>
                            </label>
                            <div class="portal-input-group">
                                <span class="portal-input-icon"><i class="bi bi-shield-lock"></i></span>
                                <input asp-for="NewPassword" type="password" class="portal-input-control" id="newPassInput" placeholder="••••••••" minlength="6" required autofocus />
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="portal-form-group mb-4">
                            <label asp-for="ConfirmPassword" class="portal-form-label">
                                <span>Confirm Password</span>
                            </label>
                            <div class="portal-input-group">
                                <span class="portal-input-icon"><i class="bi bi-shield-check"></i></span>
                                <input asp-for="ConfirmPassword" type="password" class="portal-input-control" placeholder="••••••••" minlength="6" required />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <button type="submit" class="btn-portal-submit">
                            <span>Update Password</span>
                            <i class="bi bi-check-lg"></i>
                        </button>
                    </form>
                }
            </div>

            <!-- Card Footer -->
            <div class="login-footer text-center">
                <a asp-area="StudentPortal" asp-controller="Auth" asp-action="Login" class="back-link">
                    <i class="bi bi-arrow-left me-1"></i> Return to Sign In
                </a>
            </div>
        </div>
    </div>

</body>
</html>
