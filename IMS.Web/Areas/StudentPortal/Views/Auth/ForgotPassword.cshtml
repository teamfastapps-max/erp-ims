@model IMS.Models.Portal.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Forgot Password - Student & Guardian Portal";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ERP-IMS</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Portal Design System -->
    <link rel="stylesheet" href="~/css/studentPortal.css" asp-append-version="true" />
</head>
<body class="login-page">

    <div class="login-wrapper">
        <div class="login-card shadow-lg">

            <!-- Card Header -->
            <div class="login-header">
                <div class="login-brand-icon">
                    <i class="bi bi-key-fill"></i>
                </div>
                <h4 class="fw-bold mb-1">Forgot Password</h4>
                <p class="text-muted small mb-0">Enter your registered email address to recover your account</p>
            </div>

            <!-- Form Body -->
            <div class="login-body">
                @if (Model.EmailSent)
                {
                    <div class="alert alert-success border-0 shadow-sm mb-4" role="alert">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-check-circle-fill fs-5 text-success mt-1"></i>
                            <div>
                                <h6 class="fw-bold mb-1">Reset Request Verified!</h6>
                                <p class="small mb-0">@Model.InfoMessage</p>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ResetUrlForDemo))
                    {
                        <div class="p-3 bg-light border rounded mb-4">
                            <div class="small fw-bold text-dark mb-1">
                                <i class="bi bi-link-45deg me-1 text-primary"></i>Direct Reset Link (Demo / Instant Access):
                            </div>
                            <a href="@Model.ResetUrlForDemo" class="small text-break text-primary fw-semibold">
                                Click here to set your new password
                            </a>
                        </div>
                    }

                    <a asp-area="StudentPortal" asp-controller="Auth" asp-action="Login" class="btn-portal-submit">
                        <i class="bi bi-arrow-left me-1"></i>Back to Sign In
                    </a>
                }
                else
                {
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 px-3 small border-0 shadow-sm mb-3 d-flex align-items-center gap-2 rounded-3">
                            <i class="bi bi-exclamation-octagon-fill text-danger fs-5"></i>
                            @Html.ValidationSummary(true, "", new { @class = "text-danger d-inline ps-0 mb-0" })
                        </div>
                    }

                    <form asp-area="StudentPortal" asp-controller="Auth" asp-action="ForgotPassword" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="portal-form-group mb-4">
                            <label asp-for="Email" class="portal-form-label">
                                <span>Registered Email</span>
                            </label>
                            <div class="portal-input-group">
                                <span class="portal-input-icon"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" type="email" class="portal-input-control" placeholder="name@example.com" required autofocus />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <button type="submit" class="btn-portal-submit">
                            <span>Request Password Reset</span>
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </form>
                }
            </div>

            <!-- Card Footer -->
            <div class="login-footer text-center">
                <a asp-area="StudentPortal" asp-controller="Auth" asp-action="Login" class="back-link">
                    <i class="bi bi-arrow-left me-1"></i> Return to Sign In
                </a>
            </div>
        </div>
    </div>

</body>
</html>
